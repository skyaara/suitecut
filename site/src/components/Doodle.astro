---
// A hand-drawn diagram. It draws itself in, stroke by stroke, the first time it
// comes into view; `draw="manual"` leaves that to a script.
import { renderDoodle, type Doodle } from '../lib/doodle.js'

interface Props {
  doodle: Doodle
  draw?: 'view' | 'manual'
  class?: string
}

const { doodle, draw = 'view', class: className } = Astro.props
---

<figure
  class:list={['doodle-figure', className]}
  data-doodle={draw}
  set:html={renderDoodle(doodle)}
/>

<script>
  function watch() {
    const figures = document.querySelectorAll<HTMLElement>('[data-doodle="view"]:not(.is-drawn)')
    if (!('IntersectionObserver' in window)) {
      figures.forEach((figure) => figure.classList.add('is-drawn'))
      return
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add('is-drawn')
          observer.unobserve(entry.target)
        }
      },
      { rootMargin: '0px 0px -15% 0px' },
    )
    figures.forEach((figure) => observer.observe(figure))
  }
  document.addEventListener('astro:page-load', watch)
</script>

<style is:global>
  .doodle-figure {
    margin: 0;
  }

  /* On a phone the drawing keeps a readable size and scrolls sideways instead. */
  @media (max-width: 720px) {
    .doodle-figure {
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }

    .doodle-figure .doodle {
      min-width: 600px;
    }
  }

  .doodle {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .dd-ink {
    fill: none;
    stroke: var(--heading);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dd-ink[data-cross] {
    stroke: var(--accent);
    stroke-width: 3.2;
  }

  .dd-label,
  .dd-detail,
  .dd-note,
  .dd-edge {
    font-family: var(--font-sans);
  }

  .dd-label {
    fill: var(--heading);
    font-weight: 650;
  }

  .dd-detail {
    fill: var(--muted);
    font-weight: 500;
  }

  .dd-note,
  .dd-edge {
    fill: var(--heading);
    font-weight: 600;
  }

  .dd-chip {
    fill: var(--card);
  }

  /* What moves along the arrows once the drawing is in: frames, sound, commands. */
  .dd-token {
    stroke: var(--heading);
    stroke-width: 2.2;
  }

  .dd-token-frame {
    fill: var(--doodle-yellow, var(--marker-yellow));
  }

  .dd-token-sound {
    fill: var(--doodle-blue, var(--marker-blue));
  }

  .dd-token-command {
    fill: var(--heading);
  }

  .js [data-doodle] .dd-flow {
    opacity: 0;
    transition: opacity var(--duration-enter) var(--ease-out)
      calc(var(--strokes, 0) * var(--draw-gap, 32ms) + 300ms);
  }

  .js [data-doodle].is-drawn .dd-flow {
    opacity: 1;
  }

  /* An explanation step points at its part of the drawing. */
  .doodle [data-node].is-focus .dd-ink {
    stroke: var(--accent);
  }

  /* Drawing in: each stroke's dash slides from hidden to whole, one after another. */
  .js [data-doodle] .dd-ink {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset var(--draw-stroke, 420ms) var(--ease-out)
      calc(var(--i) * var(--draw-gap, 32ms));
  }

  .js [data-doodle] :is(.dd-fill, .dd-text) {
    opacity: 0;
    transition: opacity var(--duration-enter) var(--ease-out)
      calc(var(--i) * var(--draw-gap, 32ms) + 120ms);
  }

  .js [data-doodle].is-drawn .dd-ink {
    stroke-dashoffset: 0;
  }

  .js [data-doodle].is-drawn :is(.dd-fill, .dd-text) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .dd-flow {
      display: none;
    }

    .js [data-doodle] .dd-ink {
      stroke-dashoffset: 0;
      transition: none;
    }

    .js [data-doodle] :is(.dd-fill, .dd-text) {
      transition: opacity var(--duration-enter) var(--ease-out);
    }
  }
</style>
