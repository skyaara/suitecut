---
const inputs = [
  { name: 'TypeScript SDK', note: 'record, render, stream' },
  { name: 'C++ SDK', note: 'stable C ABI, no Node.js' },
  { name: 'CLI sessions', note: 'one command per call' },
  { name: 'MCP server', note: 'stdio, grouped tools' },
]

const outputs = [
  { name: 'MP4 recording', note: '1–120 fps, page audio', kind: 'rec' },
  { name: 'RTMP and RTMPS', note: 'adaptive bitrate', kind: 'live' },
  { name: 'Live viewer', note: 'a person takes over', kind: 'hand' },
  { name: 'Traces and HAR', note: 'zip archives', kind: 'file' },
]

const paint = [
  { x: 6, y: 8, w: 22, h: 6 },
  { x: 62, y: 8, w: 32, h: 6 },
  { x: 6, y: 24, w: 54, h: 12 },
  { x: 6, y: 42, w: 40, h: 4 },
  { x: 6, y: 50, w: 46, h: 4 },
  { x: 6, y: 64, w: 28, h: 26 },
  { x: 37, y: 64, w: 28, h: 26 },
  { x: 68, y: 64, w: 26, h: 26 },
]

const wave = [
  0.35, 0.6, 0.9, 0.5, 0.75, 1, 0.65, 0.4, 0.8, 0.55, 0.95, 0.7, 0.45, 0.85, 0.6, 0.3, 0.7, 0.9,
  0.5, 0.65, 0.4, 0.8, 0.6, 0.35,
]
---

<figure class="flow" data-flow aria-label="How SuiteCut fits together">
  <div class="flow-col">
    {
      inputs.map((node, index) => (
        <div class="node node-in" style={`--i:${index}`}>
          <span class="node-name">{node.name}</span>
          <span class="node-note">{node.note}</span>
        </div>
      ))
    }
  </div>

  <div class="wire" aria-hidden="true">
    <span class="wire-name">IPC·CDP·BiDi</span>
    <span class="wire-line"><i></i><i></i><i></i><i></i></span>
  </div>

  <div class="engine">
    <div class="engine-head">
      <span>SuiteCut CEF 156</span>
      <span class="engine-live"><b></b>painting</span>
    </div>
    <div class="engine-screen" aria-hidden="true">
      <span class="screen-bar"><i></i><i></i><i></i></span>
      <span class="screen-page">
        {
          paint.map((block, index) => (
            <i
              style={`left:${block.x}%;top:${block.y}%;width:${block.w}%;height:${block.h}%;--i:${index}`}
            />
          ))
        }
        <span class="scan"></span>
      </span>
    </div>
    <div class="engine-row">
      <span>OnPaint</span>
      <span class="engine-count" data-frame>frame 0000</span>
    </div>
    <div class="film" aria-hidden="true">
      {Array.from({ length: 12 }, () => <i />)}
    </div>
    <div class="engine-row">
      <span>OnAudioStreamPacket</span>
      <span class="engine-count">48 kHz</span>
    </div>
    <div class="wave" aria-hidden="true">
      {wave.map((level, index) => <i style={`--h:${level};--i:${index}`} />)}
    </div>
  </div>

  <div class="wire" aria-hidden="true">
    <span class="wire-name">frames · PCM</span>
    <span class="wire-line"><i></i><i></i><i></i><i></i></span>
  </div>

  <div class="flow-col">
    {
      outputs.map((node, index) => (
        <div class={`node node-out is-${node.kind}`} style={`--i:${index}`}>
          <span class="node-name">
            <b aria-hidden="true" />
            {node.name}
          </span>
          <span class="node-note">{node.note}</span>
        </div>
      ))
    }
  </div>
</figure>

<script>
  for (const flow of document.querySelectorAll<HTMLElement>('[data-flow]')) {
    const counter = flow.querySelector<HTMLElement>('[data-frame]')
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let playing = false
    let start = 0
    const tick = (now: number) => {
      if (!playing) return
      if (!start) start = now
      const frame = Math.floor(((now - start) / 1000) * 120) % 10000
      if (counter) counter.textContent = `frame ${String(frame).padStart(4, '0')}`
      requestAnimationFrame(tick)
    }
    new IntersectionObserver(([entry]) => {
      const visible = entry?.isIntersecting ?? false
      flow.classList.toggle('is-playing', visible && !reduce)
      if (visible && !reduce && !playing) {
        playing = true
        requestAnimationFrame(tick)
      } else if (!visible) {
        playing = false
      }
    }).observe(flow)
  }
</script>

<style>
  .flow {
    --cycle: 4.8s;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.5rem minmax(0, 1.25fr) 5.5rem minmax(0, 1fr);
    align-items: center;
    margin: 3rem 0 0;
    padding: 2rem;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 2rem,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 2rem 100%,
      var(--panel);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .flow * {
    animation-play-state: paused;
  }

  .flow.is-playing * {
    animation-play-state: running;
  }

  .flow-col {
    display: grid;
    gap: 0.6rem;
  }

  /* Nodes */
  .node {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.85rem;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    animation: node-glow var(--cycle) ease-in-out infinite;
    animation-delay: calc(var(--i) * var(--cycle) / 4);
  }

  .node-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-strong);
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .node-note {
    color: var(--faint);
    font: 400 0.75rem / 1.4 var(--mono);
  }

  .node-in::after,
  .node-out::before {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.35rem;
    height: 0.35rem;
    background: var(--chrome-dark);
    transform: translateY(-50%);
  }

  .node-in::after {
    right: -0.2rem;
  }

  .node-out::before {
    left: -0.2rem;
  }

  @keyframes node-glow {
    0%,
    18%,
    100% {
      background: var(--paper);
      box-shadow: inset 0 0 0 1px var(--line-strong);
    }
    6% {
      background: var(--chrome);
      box-shadow:
        inset 0 0 0 1px #9aa3ae,
        0 8px 18px -12px rgb(20 24 30 / 50%);
    }
  }

  .node-out b {
    width: 0.55rem;
    height: 0.55rem;
    flex: none;
    background: var(--line-strong);
  }

  .node-out.is-rec b {
    background: #d93025;
    animation: blink 1.6s steps(2, jump-none) infinite;
  }

  .node-out.is-live b {
    background: var(--ink-strong);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .node-out.is-hand b {
    background: var(--chrome-dark);
  }

  .node-out.is-file b {
    background: var(--chrome);
    box-shadow: inset 0 0 0 1px #9aa3ae;
  }

  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  /* Wires and packets */
  .wire {
    position: relative;
    display: grid;
    gap: 0.4rem;
    align-self: stretch;
    align-content: center;
  }

  .wire-name {
    color: var(--faint);
    font: 400 0.625rem / 1.2 var(--mono);
    text-align: center;
    white-space: nowrap;
  }

  .wire-line {
    position: relative;
    height: 1px;
    background: linear-gradient(90deg, var(--line-strong), #7d8794, var(--line-strong));
  }

  .wire-line i {
    position: absolute;
    top: -2.5px;
    left: 0;
    width: 6px;
    height: 6px;
    background: var(--chrome-dark);
    box-shadow: 0 0 0 2px var(--panel);
    animation: packet 1.6s linear infinite;
  }

  .wire-line i:nth-child(2) {
    animation-delay: -0.4s;
  }

  .wire-line i:nth-child(3) {
    animation-delay: -0.8s;
  }

  .wire-line i:nth-child(4) {
    animation-delay: -1.2s;
  }

  @keyframes packet {
    from {
      left: 0;
      opacity: 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    to {
      left: calc(100% - 6px);
      opacity: 0;
    }
  }

  /* Engine */
  .engine {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: 0.9rem;
    overflow: hidden;
    background: var(--chrome);
    box-shadow:
      inset 0 1px 0 #fff,
      inset 0 0 0 1px #b9c0c9,
      0 24px 40px -26px rgb(20 24 30 / 55%);
  }

  .engine::after {
    content: '';
    position: absolute;
    inset: -50% auto -50% -60%;
    width: 40%;
    background: linear-gradient(
      100deg,
      transparent,
      rgb(255 255 255 / 70%) 45%,
      rgb(255 255 255 / 0%) 60%
    );
    transform: rotate(8deg);
    pointer-events: none;
    animation: sheen 6s ease-in-out infinite;
  }

  @keyframes sheen {
    0%,
    55% {
      left: -60%;
    }
    100% {
      left: 130%;
    }
  }

  .engine-head,
  .engine-row {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .engine-head {
    color: var(--ink-strong);
    font-size: 0.9375rem;
  }

  .engine-live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent);
    font: 400 0.6875rem / 1.4 var(--mono);
  }

  .engine-live b {
    width: 0.4rem;
    height: 0.4rem;
    background: #1e8e3e;
    animation: blink 1.2s steps(2, jump-none) infinite;
  }

  .engine-row {
    color: var(--accent-ink);
    font: 400 0.6875rem / 1.4 var(--mono);
  }

  .engine-count {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .engine-screen {
    display: grid;
    background: #fff;
    box-shadow: inset 0 0 0 1px #b9c0c9;
  }

  .screen-bar {
    display: flex;
    gap: 0.25rem;
    padding: 0.35rem 0.45rem;
    border-bottom: 1px solid var(--line);
  }

  .screen-bar i {
    width: 0.35rem;
    height: 0.35rem;
    background: var(--line-strong);
  }

  .screen-page {
    position: relative;
    aspect-ratio: 16 / 8;
    overflow: hidden;
  }

  .screen-page i {
    position: absolute;
    background: #e3e6ea;
    transform-origin: left;
    animation: paint var(--cycle) cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
    animation-delay: calc(var(--i) * 120ms);
  }

  .screen-page i:nth-child(3) {
    background: var(--chrome-dark);
  }

  .screen-page i:nth-child(n + 6) {
    background: linear-gradient(180deg, #eef0f3, #d5dae0);
  }

  @keyframes paint {
    0% {
      transform: scaleX(0);
      opacity: 0;
    }
    10%,
    82% {
      transform: scaleX(1);
      opacity: 1;
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }

  .scan {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgb(30 142 62 / 55%), transparent);
    animation: scan calc(var(--cycle) / 2) linear infinite;
  }

  @keyframes scan {
    from {
      top: 0;
    }
    to {
      top: 100%;
    }
  }

  .film {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2px;
    height: 0.9rem;
  }

  .film i {
    background: #fff;
    box-shadow: inset 0 0 0 1px #c4cad3;
  }

  .film::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: calc((100% - 22px) / 12);
    background: var(--chrome-dark);
    animation: film 1s steps(12, jump-none) infinite;
  }

  @keyframes film {
    to {
      left: calc(100% - (100% - 22px) / 12);
    }
  }

  .wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 1.6rem;
  }

  .wave i {
    flex: 1;
    height: calc(var(--h) * 100%);
    background: linear-gradient(180deg, #59616c, #1f2329);
    transform-origin: center;
    animation: wave 1.1s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -90ms);
  }

  @keyframes wave {
    from {
      transform: scaleY(0.25);
    }
    to {
      transform: scaleY(1);
    }
  }

  @media (max-width: 52rem) {
    .flow {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 1.25rem;
    }

    .wire {
      height: 3.5rem;
      justify-items: center;
    }

    .wire-name {
      position: absolute;
      top: 50%;
      left: calc(50% + 1rem);
      transform: translateY(-50%);
      text-align: left;
    }

    .wire-line {
      width: 1px;
      height: 100%;
      background: linear-gradient(180deg, var(--line-strong), #7d8794, var(--line-strong));
    }

    .wire-line i {
      top: 0;
      left: -2.5px;
      animation-name: packet-down;
    }

    @keyframes packet-down {
      from {
        top: 0;
        opacity: 0;
      }
      12%,
      88% {
        opacity: 1;
      }
      to {
        top: calc(100% - 6px);
        opacity: 0;
      }
    }

    .flow-col {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .node-in::after,
    .node-out::before {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow * {
      animation: none !important;
    }

    .film::after {
      left: 40%;
    }
  }
</style>
