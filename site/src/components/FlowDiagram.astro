---
const inputs = [
  { name: 'TypeScript SDK', note: 'record, render, stream' },
  { name: 'C++ SDK', note: 'stable C ABI, no Node.js' },
  { name: 'CLI sessions', note: 'one command per call' },
  { name: 'MCP server', note: 'stdio, grouped tools' },
]

const outputs = [
  { name: 'MP4 recording', note: '1–120 fps, page audio' },
  { name: 'RTMP and RTMPS', note: 'reconnects on failure' },
  { name: 'Live viewer', note: 'a person takes over' },
  { name: 'Traces and HAR', note: 'zip archives' },
]

// Strokes the engine "paints", as percentages of the screen.
const strokes = [
  { x: 6, y: 14, w: 18, kind: 'heavy' },
  { x: 70, y: 14, w: 24, kind: 'light' },
  { x: 6, y: 30, w: 58, kind: 'heavy' },
  { x: 6, y: 40, w: 44, kind: 'light' },
  { x: 6, y: 47, w: 50, kind: 'light' },
]
const boxes = [
  { x: 6, y: 60, w: 27 },
  { x: 36.5, y: 60, w: 27 },
  { x: 67, y: 60, w: 27 },
]
const wave = Array.from({ length: 64 }, (_, index) =>
  (0.25 + 0.75 * Math.abs(Math.sin(index * 0.45) * Math.cos(index * 0.13))).toFixed(2),
)
---

<figure class="flow" data-flow aria-label="How SuiteCut fits together">
  <div class="tier tier-in">
    {
      inputs.map((node, index) => (
        <div class="cell" style={`--i:${index}`}>
          <span class="cell-name">{node.name}</span>
          <span class="cell-note">{node.note}</span>
        </div>
      ))
    }
  </div>

  <div class="drop" aria-hidden="true">
    <i></i>
    <span>IPC · CDP · BiDi</span>
  </div>

  <div class="engine">
    <div class="engine-row engine-head">
      <span>SuiteCut CEF 156</span>
      <span class="engine-count" data-frame>frame 0000</span>
    </div>
    <div class="screen" aria-hidden="true">
      <span class="screen-bar"><i></i><i></i><i></i></span>
      {
        strokes.map((stroke, index) => (
          <i
            class={`stroke is-${stroke.kind}`}
            style={`left:${stroke.x}%;top:${stroke.y}%;width:${stroke.w}%;--i:${index}`}
          />
        ))
      }
      {
        boxes.map((box, index) => (
          <i
            class="box"
            style={`left:${box.x}%;top:${box.y}%;width:${box.w}%;--i:${index + strokes.length}`}
          />
        ))
      }
      <span class="scan"></span>
    </div>
    <div class="engine-row">
      <span>OnPaint</span>
      <span class="film" aria-hidden="true">{Array.from({ length: 24 }, () => <i />)}</span>
    </div>
    <div class="engine-row">
      <span>OnAudioStreamPacket</span>
      <span class="wave" aria-hidden="true">
        {wave.map((level, index) => <i style={`--h:${level};--i:${index}`} />)}
      </span>
    </div>
  </div>

  <div class="drop" aria-hidden="true">
    <i></i>
    <span>frames · PCM</span>
  </div>

  <div class="tier tier-out">
    {
      outputs.map((node, index) => (
        <div class="cell" style={`--i:${index}`}>
          <span class="cell-name">{node.name}</span>
          <span class="cell-note">{node.note}</span>
        </div>
      ))
    }
  </div>
</figure>

<script>
  for (const flow of document.querySelectorAll<HTMLElement>('[data-flow]')) {
    const counter = flow.querySelector<HTMLElement>('[data-frame]')
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let playing = false
    let start = 0
    const tick = (now: number) => {
      if (!playing) return
      if (!start) start = now
      const frame = Math.floor(((now - start) / 1000) * 120) % 10000
      if (counter) counter.textContent = `frame ${String(frame).padStart(4, '0')}`
      requestAnimationFrame(tick)
    }
    new IntersectionObserver(([entry]) => {
      const visible = entry?.isIntersecting ?? false
      flow.classList.toggle('is-playing', visible && !reduce)
      if (visible && !reduce && !playing) {
        playing = true
        requestAnimationFrame(tick)
      } else if (!visible) {
        playing = false
      }
    }).observe(flow)
  }
</script>

<style>
  .flow {
    --cycle: 4.8s;
    --tick: 1.75rem;
    margin: 3.5rem 0 0;
  }

  .flow * {
    animation-play-state: paused;
  }

  .flow.is-playing * {
    animation-play-state: running;
  }

  /* Tiers: four cells joined by a bus line */
  .tier {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .tier-in {
    padding-bottom: var(--tick);
  }

  .tier-out {
    padding-top: var(--tick);
  }

  .tier::after {
    content: '';
    position: absolute;
    right: calc((100% - 4.5rem) / 8);
    left: calc((100% - 4.5rem) / 8);
    height: 1px;
    background: var(--line-strong);
  }

  .tier-in::after {
    bottom: 0;
  }

  .tier-out::after {
    top: 0;
  }

  .cell {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    animation: cell-on var(--cycle) ease-in-out infinite;
    animation-delay: calc(var(--i) * var(--cycle) / 4);
  }

  .cell::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 1px;
    height: var(--tick);
    background: var(--line-strong);
  }

  .tier-in .cell::after {
    top: 100%;
  }

  .tier-out .cell::after {
    top: calc(var(--tick) * -1);
  }

  @keyframes cell-on {
    0%,
    24%,
    100% {
      border-color: var(--line-strong);
    }
    8%,
    16% {
      border-color: var(--ink-strong);
    }
  }

  .cell-name {
    color: var(--ink-strong);
    font-size: 1.125rem;
    line-height: 1.5rem;
  }

  .cell-note {
    color: var(--faint);
    font: 400 0.8125rem / 1.4 var(--sans);
  }

  /* Vertical drops with a travelling pulse */
  .drop {
    position: relative;
    height: 5.5rem;
  }

  .drop::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--line-strong);
  }

  .drop i {
    position: absolute;
    top: 0;
    left: calc(50% - 2px);
    width: 5px;
    height: 5px;
    background: var(--ink-strong);
    animation: pulse-down 1.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .drop span {
    position: absolute;
    top: 50%;
    left: calc(50% + 1rem);
    color: var(--faint);
    font: 400 0.8125rem / 1 var(--sans);
    transform: translateY(-50%);
    white-space: nowrap;
  }

  @keyframes pulse-down {
    from {
      top: 0;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    to {
      top: calc(100% - 5px);
      opacity: 0;
    }
  }

  /* Engine */
  .engine {
    border: 1px solid var(--ink-strong);
    background: var(--paper);
  }

  .engine-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--line-strong);
    color: var(--muted);
    font: 400 0.8125rem / 1.4 var(--sans);
  }

  .engine-head {
    border-top: 0;
    color: var(--ink-strong);
    font: 500 1.125rem / 1.5rem var(--sans);
  }

  .engine-count {
    color: var(--faint);
    font: 400 0.8125rem / 1 var(--sans);
    font-variant-numeric: tabular-nums;
  }

  .screen {
    position: relative;
    aspect-ratio: 16 / 6;
    margin: 0 1.25rem 1.25rem;
    overflow: hidden;
    border: 1px solid var(--line-strong);
  }

  .screen-bar {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    gap: 0.3rem;
    height: 1.4rem;
    align-items: center;
    padding: 0 0.6rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .screen-bar i {
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--line-strong);
  }

  .stroke,
  .box {
    position: absolute;
    transform-origin: left;
    animation: draw var(--cycle) cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
    animation-delay: calc(var(--i) * 140ms);
  }

  .stroke.is-heavy {
    height: 3px;
    background: var(--ink-strong);
  }

  .stroke.is-light {
    height: 1px;
    background: var(--faint);
  }

  .box {
    height: 26%;
    border: 1px solid var(--line-strong);
  }

  @keyframes draw {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    12%,
    80% {
      transform: scaleX(1);
      opacity: 1;
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }

  .scan {
    position: absolute;
    right: 0;
    left: 0;
    top: 1.4rem;
    height: 1px;
    background: var(--ink-strong);
    opacity: 0.18;
    animation: scan calc(var(--cycle) / 2) linear infinite;
  }

  @keyframes scan {
    to {
      top: 100%;
    }
  }

  .film {
    position: relative;
    display: grid;
    flex: 0 1 18rem;
    grid-template-columns: repeat(24, 1fr);
    height: 0.75rem;
    border: 1px solid var(--line-strong);
    border-right: 0;
  }

  .film i {
    border-right: 1px solid var(--line-strong);
  }

  .film::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: calc(100% / 24);
    background: var(--ink-strong);
    animation: film 0.8s steps(24, jump-none) infinite;
  }

  @keyframes film {
    to {
      left: calc(100% - 100% / 24);
    }
  }

  .wave {
    display: flex;
    flex: 0 1 18rem;
    align-items: center;
    justify-content: space-between;
    height: 1.5rem;
  }

  .wave i {
    width: 1px;
    height: calc(var(--h) * 100%);
    background: var(--ink-strong);
    animation: wave 1.2s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -70ms);
  }

  @keyframes wave {
    from {
      transform: scaleY(0.2);
    }
  }

  @media (max-width: 52rem) {
    .tier {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 1rem;
      padding: 0;
    }

    .tier::after,
    .cell::after {
      display: none;
    }

    .screen {
      aspect-ratio: 16 / 9;
      margin: 0 1rem 1rem;
    }

    .engine-row {
      flex-wrap: wrap;
      gap: 0.6rem;
      padding: 0.75rem 1rem;
    }

    .film,
    .wave {
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow * {
      animation: none !important;
    }

    .film::after {
      left: 40%;
    }
  }
</style>
