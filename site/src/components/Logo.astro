---
// Each instance needs its own gradient id; the header and the pinned bar both render the logo.
const id = `chrome-${Math.random().toString(36).slice(2, 8)}`
---

<svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#eef0f3"></stop>
      <stop offset="0.3" stop-color="#bcc3cb"></stop>
      <stop offset="0.47" stop-color="#5d6570"></stop>
      <stop offset="0.55" stop-color="#8e97a2"></stop>
      <stop offset="0.72" stop-color="#e2e6ea"></stop>
      <stop offset="1" stop-color="#7f8894"></stop>
    </linearGradient>
  </defs>
  <g fill={`url(#${id})`}>
    <path d="M4 4H26.25L4 26.25Z"></path>
    <path d="M28 5.75V28H5.75Z"></path>
  </g>
</svg>
<span class="wordmark-text">suitecut</span>
