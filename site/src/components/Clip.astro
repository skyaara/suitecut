---
// A real recording in the docs, with what it shows underneath. A clip with sound
// waits for a press; a silent one plays on a loop.
import { sitePath } from '../lib/paths.js'

interface Props {
  /** File name under /demo, without the extension; the poster shares it. */
  name: string
  title: string
  sound?: boolean
  /** A tall phone recording, shown at phone width. */
  portrait?: boolean
}

const { name, title, sound = false, portrait = false }: Props = Astro.props
const src = sitePath(`/demo/${name}.mp4`)
const poster = sitePath(`/demo/${name}.jpg`)
---

<figure class:list={['clip', { portrait }]}>
  {
    sound ? (
      <video {src} {poster} controls playsinline preload="none" aria-label={title} />
    ) : (
      <video {src} {poster} autoplay muted loop playsinline preload="metadata" aria-label={title} />
    )
  }
  <figcaption>
    {title}
    <slot />
  </figcaption>
</figure>

<style>
  .clip {
    margin: var(--space-6) 0 var(--space-8);
  }

  /* The video sits in an expression, which Astro does not scope. */
  .clip :global(video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    background: var(--card-sunken);
  }

  .clip.portrait :global(video) {
    max-width: 320px;
  }

  .clip figcaption {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: 16px;
    line-height: 24px;
  }
</style>
