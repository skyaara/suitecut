---
import { sitePath } from '../lib/paths.js'
import Logo from './Logo.astro'

interface Props {
  current?: 'home' | 'docs' | 'examples' | 'benchmarks'
}

const { current } = Astro.props
---

<header class="site-header">
  <a class="wordmark" href={sitePath('/')} aria-label="SuiteCut home"><Logo /></a>
  <nav aria-label="Primary navigation">
    {
      current !== 'home' && (
        <a class="home-nav-link" href={sitePath('/')}>
          Home
        </a>
      )
    }
    <a href={sitePath('/docs')} aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
    <a href={sitePath('/examples')} aria-current={current === 'examples' ? 'page' : undefined}
      >Examples</a
    >
    <a href={sitePath('/benchmarks')} aria-current={current === 'benchmarks' ? 'page' : undefined}
      >Benchmarks</a
    >
    <a href="https://github.com/skyaara/suitecut">GitHub</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 72px;
    gap: 2rem;
    padding-inline: clamp(1.5rem, 3vw, 3.5rem);
    border-bottom: 1px solid var(--border);
    background: #111111f5;
    backdrop-filter: blur(14px);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .wordmark :global(.logo-mark) {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  nav a {
    color: #a7a7a7;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 27px;
    text-decoration-thickness: 2px;
  }
  @media (max-width: 820px) {
    .site-header {
      padding-inline: 1.25rem;
      gap: 1rem;
    }
    nav {
      gap: 1rem;
    }
  }
  @media (max-width: 420px) {
    .home-nav-link {
      display: none;
    }
    nav {
      gap: 0.8rem;
    }
    nav a {
      font-size: 0.72rem;
    }
    .wordmark {
      font-size: 0.94rem;
    }
  }
</style>
