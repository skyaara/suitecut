---
// Every component as a row: its name, linked to its page, and what it is.
import { components } from '../data/components.js'
import { sitePath } from '../lib/paths.js'

interface Props {
  except?: string
}

const { except } = Astro.props
---

<ul class="dp-rows component-rows">
  {
    components
      .filter((item) => item.slug !== except)
      .map((item) => (
        <li>
          <a class="dp-link" href={sitePath(`/components/${item.slug}`)}>
            {item.name}
          </a>
          <span class="dp-detail">{item.line}</span>
        </li>
      ))
  }
</ul>

<style>
  .component-rows {
    margin: var(--space-6) 0 var(--space-8);
  }

  .component-rows a {
    color: var(--heading);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
