---
// A package's explainer film, recorded and narrated by suitecut. Sound is on, so it
// waits for a press instead of autoplaying.
import { sitePath } from '../lib/paths.js'

interface Props {
  slug: string
  title: string
}

const { slug, title } = Astro.props
---

<figure class="film">
  <video
    src={sitePath(`/films/${slug}.mp4`)}
    poster={sitePath(`/films/${slug}.jpg`)}
    controls
    playsinline
    preload="none"
    aria-label={title}></video>
  <figcaption>{title}. Recorded, narrated and rendered by suitecut.</figcaption>
</figure>

<style>
  .film {
    margin: var(--space-8) 0;
  }

  .film video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    background: var(--card-sunken);
  }

  .film figcaption {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: 16px;
    line-height: 24px;
  }
</style>
