---
import CodeBlock from '../../components/CodeBlock.astro'
import ComponentRows from '../../components/ComponentRows.astro'
import Doodle from '../../components/Doodle.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { components, type Component, type Language } from '../../data/components.js'
import { sitePath } from '../../lib/paths.js'

export function getStaticPaths() {
  return components.map((item) => ({ params: { slug: item.slug }, props: { item } }))
}

interface Props {
  item: Component
}

const { item }: Props = Astro.props
const languages: Record<Language, { label: string; lang: 'cpp' | 'json' | 'bash' | 'plaintext' }> =
  {
    cpp: { label: 'C++', lang: 'cpp' },
    c: { label: 'C', lang: 'cpp' },
    json: { label: 'JSON', lang: 'json' },
    sh: { label: 'Terminal', lang: 'bash' },
    cmake: { label: 'CMake', lang: 'plaintext' },
  }
const external = (href: string) => href.startsWith('http')
const index = components.indexOf(item)
const next = components[(index + 1) % components.length]
---

<BaseLayout title={`${item.name} · suitecut`} description={`${item.line}.`} current="components">
  <article class="prose component">
    <h1>{item.name}</h1>
    <p class="component-line">{item.line}.</p>
    <p class="component-kind">
      <span class="dp-badge dp-badge-neutral">{item.kind}</span>
      <span class="dp-badge dp-badge-neutral">{item.status}</span>
    </p>

    <h2 id="how">How it works</h2>
    {
      item.intro.map((paragraph) =>
        paragraph === item.marker ? (
          <p>
            <span class="dp-marker dp-marker-red dp-marker-inline">{paragraph}</span>
          </p>
        ) : (
          <p>{paragraph}</p>
        ),
      )
    }
    <Doodle doodle={item.doodle} class="component-doodle" />
    <p class="doodle-caption">{item.doodle.title}</p>

    <h2 id="start">Quick start</h2>
    <h3>{item.start.title}</h3>
    <CodeBlock
      code={item.start.code}
      label={languages[item.start.language].label}
      lang={languages[item.start.language].lang}
    />
    {
      item.examples.map((example) => (
        <>
          <h3>{example.title}</h3>
          <CodeBlock
            code={example.code}
            label={languages[example.language].label}
            lang={languages[example.language].lang}
          />
        </>
      ))
    }

    <h2 id="facts">What you get</h2>
    <ul class="dp-rows facts">
      {
        item.facts.map(([name, detail]) => (
          <li>
            <span>{name}</span>
            <span class="dp-detail">{detail}</span>
          </li>
        ))
      }
    </ul>

    <h2 id="limits">Limits</h2>
    <ul>
      {item.limits.map((limit) => <li>{limit}</li>)}
    </ul>

    <h2 id="more">Read more</h2>
    <ul class="dp-rows">
      {
        item.links.map(([label, href]) => (
          <li>
            <a
              class="dp-link"
              href={external(href) ? href : sitePath(href)}
              target={external(href) ? '_blank' : undefined}
              rel={external(href) ? 'noopener noreferrer' : undefined}
            >
              {label}
            </a>
            <span class="dp-detail">{external(href) ? 'GitHub' : 'Docs'}</span>
          </li>
        ))
      }
    </ul>

    <h2 id="others">Other components</h2>
    <ComponentRows except={item.slug} />
    {
      next && (
        <p>
          <a class="tag" href={sitePath(`/components/${next.slug}`)}>
            Next: {next.name}
          </a>
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  .component {
    padding-top: var(--space-18);
  }

  .component h1 {
    max-width: none;
    margin-bottom: var(--space-5);
    overflow-wrap: anywhere;
  }

  .component-line {
    max-width: 32rem;
  }

  .component-kind {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: 16px;
    line-height: 24px;
  }

  /* Diagrams take the card's full width so their labels stay readable. */
  .component :global(.component-doodle) {
    margin: var(--space-8) calc(var(--space-6) - var(--gutter)) var(--space-3);
  }

  .doodle-caption {
    color: var(--muted);
    font-size: 16px;
    line-height: 24px;
  }

  .facts li > span:first-child {
    color: var(--heading);
    font-weight: 600;
  }
</style>
