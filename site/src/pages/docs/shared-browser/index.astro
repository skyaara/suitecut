---
import Clip from '../../../components/Clip.astro'
import CodeBlock from '../../../components/CodeBlock.astro'
import Explainer from '../../../components/Explainer.astro'
import { diagrams } from '../../../data/diagrams.js'
import DocsLayout from '../../../layouts/DocsLayout.astro'
import { sitePath } from '../../../lib/paths.js'

const install = `npx -y @suitecut/shared-browser --executable /absolute/path/to/suitecut-browser`

const mcpConfig = `{
  "mcpServers": {
    "suitecut-browser": {
      "command": "npx",
      "args": ["-y", "@suitecut/shared-browser", "--executable", "/absolute/path/to/suitecut-browser"]
    }
  }
}`

const sdk = `import { launchSharedBrowser } from '@suitecut/shared-browser'

const browser = await launchSharedBrowser({
  executablePath: '/absolute/path/to/suitecut-browser',
  url: 'https://www.ebay.com/',
})
const tab = await browser.activeTab()
console.log(await tab.snapshot()) // headings, text and controls with refs
await tab.clickRef('e4')
const png = await tab.screenshot()
await browser.close()`

const recording = `const recording = await browser.startRecording({
  path: 'session.mp4',
  fps: 30, // at least 1, default 60; extra paints are skipped before copying
  audio: true, // the front tab's sound; off by default
})
const results = await browser.activeTab() // eBay's search results
await results.clickRef('e57') // a listing, which eBay opens in a new tab
const listing = await browser.newTab(await results.url()) // or open one yourself
await listing.wheel(0, 600)
await results.select() // the recording follows the tab in front
const result = await recording.stop()
console.log(result.outputFrames, result.heldFrames, result.outputBytes)`

const song = `const recording = await browser.startRecording({ path: 'song-maker.mp4', fps: 30, audio: true })
for (const [beat, row] of [0, 2, 4, 5, 4, 2, 1, 0].entries()) {
  const x = grid.x + (grid.width * (beat * 4 + 0.5)) / 32
  const y = grid.y + (grid.height * (13 - row + 0.5)) / 14
  await tab.click(x, y) // trusted input, not a synthetic DOM event
}
await tab.click(play.x, play.y)
await sleep(4500)
await recording.stop()`

type Spec = [string, string]

const recordingSpecs: Spec[] = [
  ['Source', "The window's own compositor frames, not screen recording; no permission prompt"],
  ['Area', 'The tab in front; switching tabs switches what is recorded'],
  ['Video', 'H.264 from the hardware encoder at a constant rate; size follows the window, at 2x'],
  ['Sound', '48 kHz stereo AAC from the front tab, with audio: true'],
  ['Still pages', 'The last frame is held and counted, so a still page costs almost nothing'],
  ['Minimised', 'The last frame is held until the window comes back'],
  [
    'Safety',
    'An existing file is never overwritten; a second recording to the same path is refused',
  ],
]

const sdkSpecs: Spec[] = [
  ['Tabs', 'tabs(), newTab(url), tab(id) and activeTab(); popups open as tabs'],
  ['Navigation', 'goto, back, forward and reload wait for loading; load errors are returned'],
  ['Reading', 'snapshot(), title(), url(), content(), screenshot() and evaluate()'],
  ['Input', 'click, type, press, wheel, clickRef and fillRef, as trusted browser input'],
  ['Dialogs', "Wait for answerDialog() by default; reads of a paused page say why they can't run"],
  [
    'Permissions',
    "'ask' shows Allow and Block in the toolbar; 'allow' and 'deny' answer every prompt",
  ],
]

const tools = [
  'browser_navigate',
  'browser_snapshot',
  'browser_click',
  'browser_hover',
  'browser_type',
  'browser_press',
  'browser_scroll',
  'browser_evaluate',
  'browser_screenshot',
  'browser_wait_for',
  'browser_back',
  'browser_reload',
  'browser_tabs',
  'browser_new_tab',
  'browser_select_tab',
  'browser_close_tab',
  'browser_dialog',
  'browser_permission',
  'browser_events',
  'browser_record_start',
  'browser_record_stop',
]
---

<DocsLayout
  title="Shared browser"
  description="One browser window that you and an AI agent use together, with a TypeScript SDK and an MCP server."
  section="shared-browser"
>
  <h1>Shared browser</h1>
  <p>
    <code>@suitecut/shared-browser</code> opens one native window with suitecut's own tab strip and toolbar
    around real Chromium tabs. You use it like any browser, and an agent drives the same tabs through
    MCP or the TypeScript SDK. It is a preview for macOS on Apple silicon; see the
    <a href={sitePath('/packages/shared-browser')}>package page</a> for its film.
  </p>

  <h2 id="how">How it works</h2>
  <Explainer explained={diagrams.sharedBrowser} />

  <h2 id="mcp">MCP server</h2>
  <p>
    The server speaks MCP over stdio. <code>--executable</code> falls back to
    <code>SUITECUT_SHARED_BROWSER</code>. The browser starts on the first tool call, and again if
    its window was closed.
  </p>
  <CodeBlock code={install} label="Terminal" />
  <CodeBlock code={mcpConfig} label="MCP config" lang="json" />
  <p>Twenty-one tools:</p>
  <p class="tools">
    {tools.map((tool) => <code>{tool}</code>)}
  </p>

  <h2 id="sdk">TypeScript SDK</h2>
  <CodeBlock code={sdk} />
  <ul class="dp-rows">
    {
      sdkSpecs.map(([key, value]) => (
        <li>
          <span class="spec-name">{key}</span>
          <span class="dp-detail">{value}</span>
        </li>
      ))
    }
  </ul>
  <p>
    A ref such as <code>e12</code> is a position among the visible interactive elements in the last snapshot.
    It is looked up again when it is used, so the page's DOM and globals are never touched.
  </p>

  <h2 id="recording">Recording</h2>
  <p>
    The shared browser can record itself while you and the agent use it. Frames come from Chromium's
    compositor as it hands them to the window, so the video shows exactly what was on screen, at the
    rate you ask for. <a href={sitePath('/docs/how-it-works#window')}>How it works</a> explains the path
    and compares it with the DevTools screencast.
  </p>
  <CodeBlock code={recording} />
  <Clip
    name="agent-window"
    title="The shared browser recording itself while an agent shops on eBay."
  >
    {' '}201 real frames and 273 held ones: a still page costs nothing. The dark second is the new
    tab before the listing painted. The script is
    <a href={sitePath('/examples#agent-window')}>on the examples page</a>.
  </Clip>
  <ul class="dp-rows">
    {
      recordingSpecs.map(([key, value]) => (
        <li>
          <span class="spec-name">{key}</span>
          <span class="dp-detail">{value}</span>
        </li>
      ))
    }
  </ul>

  <h3 id="recording-sound">With sound</h3>
  <p>
    CEF silences a page while it captures that page's sound. So the shared browser only captures
    sound while a recording with <code>audio: true</code> runs, and plays what it captures back to the
    speakers. You keep hearing the page. A sound that was already playing when the recording started is
    picked up.
  </p>
  <CodeBlock code={song} />
  <Clip
    name="shared-song-maker"
    title="Song Maker, played and recorded in the shared browser. Turn the sound on."
    sound
  >
    {' '}10 seconds at 2560×1504, 618 KB.
  </Clip>

  <h3 id="recording-mcp">From an agent</h3>
  <p>
    <code>browser_record_start</code> takes a <code>path</code> and optionally <code>fps</code>
    and <code>audio</code>. <code>browser_record_stop</code> stops the latest recording, or the one named
    by <code>recording</code>, and replies with the length, size and how many frames were new or
    held. Pass <code>discard: true</code> to throw the file away.
  </p>

  <h2 id="limits">Limits</h2>
  <ul>
    <li>
      A preview: macOS on Apple silicon, with the suitecut browser built from this repository.
    </li>
    <li>
      Recordings carry the sound of the tab in front only, and one recording with sound can run at a
      time. After it stops, capture can stay on until the page next goes quiet; you still hear it.
    </li>
    <li>
      A hidden tab draws no frames. The first input or screenshot on a tab turns on focus emulation
      so it keeps rendering, as Playwright does.
    </li>
    <li>
      Back and Forward reload pages instead of restoring them from the cache, which keeps window
      geometry correct after navigation.
    </li>
  </ul>
</DocsLayout>

<style>
  .spec-name {
    color: var(--heading);
    font-weight: 600;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
