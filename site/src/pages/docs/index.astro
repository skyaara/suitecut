---
import CodeBlock from '../../components/CodeBlock.astro'
import DocsLayout from '../../layouts/DocsLayout.astro'
import { recordExample } from '../../lib/api-reference.js'

const installCommands = `git lfs install
git clone https://github.com/skyaara/suitecut.git
cd suitecut
git lfs pull
pnpm install --frozen-lockfile
pnpm build`

const setupCommands = `export SUITECUT_NATIVE_EXECUTABLE="/absolute/path/to/suitecut-browser"
node dist/cli.js install
node dist/cli.js doctor`
---

<DocsLayout
  title="Getting started"
  description="Set up native CEF browser capture, recording and rendering."
  section="overview"
>
  <h1>Getting started</h1>
  <h2 id="requirements">Requirements</h2>
  <p>
    Use Node.js 22 or newer, pnpm 11, FFmpeg and FFprobe, and a separately built native CEF browser.
    The engine is a pinned CEF 156 build on the Chromium 156 beta channel.
  </p>
  <p>
    Linux x64 and macOS ARM64 are qualified separately. macOS is qualified on 27.0.1 with Apple
    silicon; older releases and Intel Macs aren't. Windows runtime packaging isn't implemented.
  </p>

  <h2 id="install">Install</h2>
  <p>
    The Kokoro voice model is stored with Git LFS, so install it before cloning. Then build the
    TypeScript packages.
  </p>
  <CodeBlock label="Terminal" code={installCommands} />
  <p>
    Follow the <a href="https://github.com/skyaara/suitecut/blob/main/native/browser/README.md"
      >native build instructions</a
    > for the CEF browser, then point suitecut at it. <code>install</code> downloads checksum-verified
    FFmpeg and FFprobe; set <code>SUITECUT_FFMPEG_PATH</code> and <code>SUITECUT_FFPROBE_PATH</code>
    to use your own. <code>doctor</code> checks the setup.
  </p>
  <CodeBlock label="Terminal" code={setupCommands} />

  <h2 id="record-a-flow">Record a flow</h2>
  <CodeBlock code={recordExample} />

  <h2 id="run-and-render">Run and render</h2>
  <p>
    The recorder closes its primary browser, saves source clips and writes a manifest. The renderer
    composes selected intervals and mixes page audio with narration.
  </p>

  <h2 id="render-quality">Render quality</h2>
  <p>
    Choose output dimensions, a frame rate up to 120 (fractional rates such as 29.97 work), quality
    profiles and supported FFmpeg encoders. Higher output rates can repeat captured images; they
    don't create motion the browser didn't capture.
  </p>
</DocsLayout>
