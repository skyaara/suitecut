---
import CodeBlock from '../../../components/CodeBlock.astro'
import DocsLayout from '../../../layouts/DocsLayout.astro'

const example = `test('opens the account', async ({ page, suitecut }) => {
  await page.goto('/account')
  suitecut.narrate('The account page is open.')

  const billing = page.getByRole('link', { name: 'Billing' })
  await suitecut.highlight(billing, { borderColor: '#71352e' })
  await billing.click()
  suitecut.hold(500)
  await suitecut.checkpoint('Billing page')
})`
---

<DocsLayout title="Fixture API" description="SuiteCut Playwright fixture methods." section="api">
  <p class="kicker">Field manual · 02</p>
  <h1>Fixture API</h1>
  <p>
    The <code>suitecut</code> fixture adds presentation direction without delaying test actions.
  </p>

  <ul class="api-list">
    <li>
      <strong>selectPage(page): void</strong>Chooses the main page, popup, or secondary page for
      later events.
    </li>
    <li>
      <strong>narrate(text, options?): void</strong>Queues local speech and an optional caption at
      the current test time.
    </li>
    <li>
      <strong>checkpoint(label, options?): Promise&lt;void&gt;</strong>Captures named PNG evidence
      and records it in the manifest.
    </li>
    <li>
      <strong>highlight(locator, options?): Promise&lt;void&gt;</strong>Captures locator geometry
      for an outline, fill, or spotlight callout.
    </li>
    <li>
      <strong>zoom(locator, options?): Promise&lt;void&gt;</strong>Captures a target region for a
      closer camera crop.
    </li>
    <li>
      <strong>hold(durationMs): void</strong>Adds presentation time to the render without sleeping
      in the test.
    </li>
  </ul>

  <h2>A directed test</h2>
  <CodeBlock code={example} />

  <h2>Validation</h2>
  <p>
    Public inputs are parsed through strict schemas. Empty labels, invalid durations, unsupported
    providers, extra option keys, and malformed render requests fail at the boundary.
  </p>
</DocsLayout>
