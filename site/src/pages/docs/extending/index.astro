---
import CodeBlock from '../../../components/CodeBlock.astro'
import DocsLayout from '../../../layouts/DocsLayout.astro'
import { sitePath } from '../../../lib/paths.js'

const steps = `import { record } from 'suitecut'

// A step of your own is a function that uses the ones suitecut has.
async function explain(suitecut, locator, line) {
  await suitecut.highlight(locator)
  await suitecut.narrate(line)
  await suitecut.checkpoint(line)
}

await record('Tour', async ({ page, suitecut }) => {
  await page.goto('https://www.ebay.com/')
  await explain(suitecut, page.locator('h1'), 'This is the store.')
})`

const frames = `import { launchBrowser } from 'suitecut'

const browser = await launchBrowser({ framesPerSecond: 60 })
const stopFrames = browser.onFrame((frame) => {
  // frame.data is I420 (or BGRA), frame.timestampMs is on performance.now()
  analyse(frame.data, frame.width, frame.height, frame.timestampMs)
})
const stopAudio = browser.onAudio((packet) => {
  // 48 kHz stereo signed 16-bit PCM, with the time of its first sample
  listen(packet.data, packet.timestampMs)
})
await browser.navigate('https://www.ebay.com/')`

const voice = `import { writeFile } from 'node:fs/promises'
import { defineSuiteCutAudioPlugin, encodePcm16Wav } from 'suitecut/audio-plugin'

export default defineSuiteCutAudioPlugin({
  async synthesize({ text, voice, speed, outputPath, options }) {
    const { samples, sampleRate } = await myModel({ text, voice, speed, options })
    await writeFile(outputPath, encodePcm16Wav(samples, sampleRate))
  },
})`

const output = `await renderSuiteCut({
  manifestPath: run.manifestPath,
  outputPath: 'tour.mp4',
  config: { output: { width: 1920, height: 1080, framesPerSecond: 60 } },
})`

const broadcast = `import { launchBrowser, createBroadcast } from 'suitecut'

const source = await launchBrowser({ framesPerSecond: 60 })
const broadcast = await createBroadcast({
  source,
  stream: { url: process.env.RTMP_URL, framesPerSecond: 60, audio: true },
})`

const backends = `import { launchBrowser } from '@suitecut/browser-control'

// The same code against suitecut's engine, an installed Chrome, or Firefox.
const browser = await launchBrowser({ backend: 'cdp', executablePath: '/path/to/chrome' })
const page = await browser.newPage()
await page.goto('https://www.apple.com/shop/buy-iphone')`

const mcp = `{
  "mcpServers": {
    "browser": {
      "command": "suitecut-native-control",
      "args": ["--browser", "/usr/bin/chromium", "--mcp", "--tools", "core,network,state"]
    },
    "shared-browser": {
      "command": "npx",
      "args": ["-y", "@suitecut/shared-browser", "--executable", "/path/to/suitecut-browser"]
    }
  }
}`

const c = `#include <suitecut/client.h>

sc_launch_options options;
sc_launch_options_init(&options);
options.executable = "/usr/bin/chromium";

sc_client *client = NULL;
sc_packet *packet = NULL;
sc_error error;
sc_client_launch_chromium(&options, &client, &error);
sc_client_ready(client, &packet, &error);
sc_packet_destroy(packet);

const char *command = "{\\"command\\":\\"evaluate\\",\\"expression\\":\\"6*7\\"}";
sc_client_call(client, command, strlen(command), 5000, &packet, &error);
/* sc_packet_payload(packet, &size) holds {"result":{"value":42}} */
sc_packet_destroy(packet);
sc_client_close(client, &error);
sc_client_destroy(client);`

type Row = readonly [string, string, string]

const points: Row[] = [
  ['Steps', 'Your own functions around highlight, zoom, narrate and click', '#steps'],
  ['Frames and sound', 'onFrame and onAudio, straight from the renderer', '#frames'],
  ['Voices', 'A narration engine as a separate package', '#voices'],
  ['Output', 'Size, frame rate, encoder and quality of the finished video', '#output'],
  ['Live', 'Stream the same pipeline to RTMP or RTMPS', '#live'],
  ['Browsers', 'The suitecut engine, Chrome, Edge, Brave or Firefox', '#browsers'],
  ['Agents', 'Any MCP host, with only the tool groups it needs', '#agents'],
  ['Languages', 'C++, or any language that can call C', '#languages'],
]
---

<DocsLayout
  title="Extending suitecut"
  description="Where your own code plugs into suitecut: steps, raw frames and sound, voices, output, live streams, browsers, agents and other languages."
  section="extending"
>
  <h1>Extending suitecut</h1>
  <p>
    Each part described in <a href={sitePath('/docs/how-it-works')}>how it works</a> has a place where
    your own code can take over. None of them need changes to suitecut itself.
  </p>
  <ul class="dp-rows">
    {
      points.map(([name, detail, href]) => (
        <li>
          <a class="dp-link" href={href}>
            {name}
          </a>
          <span class="dp-detail">{detail}</span>
        </li>
      ))
    }
  </ul>

  <h2 id="steps">Your own steps</h2>
  <p>
    A recording callback is ordinary async code with a Playwright-style <code>page</code> and the
    <code>suitecut</code> fixture. Wrap the steps you repeat in functions and share them like any other
    module. A <code>checkpoint</code> marks a moment in the manifest that the renderer and your tests
    can find again.
  </p>
  <CodeBlock code={steps} />

  <h2 id="frames">Frames and sound</h2>
  <p>
    Skip the recorder and take the renderer's output yourself, for computer vision, your own encoder
    or a test that checks the screen. Frames and audio packets are owned copies, with timestamps on
    the same clock. Keep listeners quick: the native side never waits for them, and a frame that a
    slow listener misses is counted in <code>droppedFrames</code>.
  </p>
  <CodeBlock code={frames} />

  <h2 id="voices">Voices</h2>
  <p>
    Narration runs in a worker that loads a voice package by name. Kokoro is built in; the
    <a href={sitePath('/docs/audio-plugins')}>audio plugins</a> add VITS, Piper, Matcha and others. A
    plugin of your own writes a WAV for each line, and suitecut times the captions and the mix from it.
  </p>
  <CodeBlock code={voice} />

  <h2 id="output">Output</h2>
  <p>
    Rendering is separate from recording, so you can render one recording at several sizes, rates or
    encoders. Any rate from 1 fps works, including 29.97 and 59.94. A higher rate than the capture
    repeats frames; it doesn't invent motion. See the <a href={sitePath('/docs/api')}>API</a> for the
    quality profiles and supported encoders.
  </p>
  <CodeBlock code={output} />

  <h2 id="live">Live</h2>
  <p>
    The live publisher takes the same frames and sound and sends H.264 and AAC over RTMP or RTMPS,
    with an optional reconnect policy. Several publishers can share one page. See <a
      href={sitePath('/docs/streaming')}>live streaming</a
    >.
  </p>
  <CodeBlock code={broadcast} />

  <h2 id="browsers">Browsers</h2>
  <p>
    <a href={sitePath('/docs/browser-control')}>Browser control</a> keeps one API over three backends:
    <code>cef</code>, the suitecut engine, <code>cdp</code> for an installed Chrome, Chromium, Edge or
    Brave, and <code>bidi</code> for Firefox. It can also attach to a browser that is already running,
    on this machine or another one.
  </p>
  <CodeBlock code={backends} />

  <h2 id="agents">Agents</h2>
  <p>
    Two MCP servers, for two jobs. <code>suitecut-native-control</code> drives a browser of its own and
    loads tool groups on request: <code>core</code> by default, plus <code>network</code>,
    <code>state</code>, <code>debug</code>, <code>media</code> or <code>all</code>. Fewer tools
    leave the model more context for the page. The <a href={sitePath('/docs/shared-browser')}
      >shared browser</a
    > puts the agent in a window you can see and use too, and can record it.
  </p>
  <CodeBlock code={mcp} label="MCP config" lang="json" />

  <h2 id="languages">Other languages</h2>
  <p>
    The <a href={sitePath('/docs/agents')}>C++ library</a> has a stable C ABI, so anything that can call
    C can drive a browser: Python, Rust, Go, Swift. Commands are JSON strings; replies come back as packets
    with a JSON header and a payload. The ABI is versioned separately from the npm packages.
  </p>
  <CodeBlock code={c} label="C" lang="cpp" />
  <p>
    From a shell, <code>suitecut-native-control</code> keeps named sessions, so each command is one process
    call and a browser stays open between them.
  </p>
</DocsLayout>
