---
import nativeSource from '../../../../examples/native.ts?raw'
import CodeBlock from '../../components/CodeBlock.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { streamExample } from '../../lib/api-reference.js'
---

<BaseLayout
  title="Native examples · SuiteCut"
  description="Record, render and stream with SuiteCut's native CEF source."
  current="examples"
>
  <article class="docs-article">
    <h1>Native examples</h1>
    <h2>Record and render</h2>
    <p>
      Build the pinned CEF executable and set <code>SUITECUT_NATIVE_EXECUTABLE</code>, then run <code
        >pnpm example:native</code
      >.
    </p>
    <CodeBlock code={nativeSource} />
    <h2>Publish a source</h2>
    <p>
      The application owns the browser and stop signal. Keep publishing credentials in environment
      variables.
    </p>
    <CodeBlock code={streamExample} />
  </article>
</BaseLayout>
