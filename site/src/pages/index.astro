---
import { Code } from 'astro:components'

import BaseLayout from '../layouts/BaseLayout.astro'

const example = `import { record } from 'suitecut'

await record('records the product', async ({
  page,
  suitecut,
}) => {
  await page.goto('https://suitecut.aakashreddy.com')
  await suitecut.narrate('The workspace is ready.')
  await suitecut.checkpoint('Workspace ready')
})`
---

<BaseLayout
  title="SuiteCut · Product videos from Playwright"
  description="Turn a Playwright recording into a narrated product video."
  current="home"
>
  <section class="home-reference" aria-labelledby="home-title">
    <h1 id="home-title" class="visually-hidden">
      Turn a Playwright recording into a product video.
    </h1>
    <div class="home-reference-code">
      <p>recording.ts</p>
      <Code code={example} lang="typescript" theme="github-dark" />
    </div>
  </section>
</BaseLayout>
