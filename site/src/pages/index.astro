---
import CodeBlock from '../components/CodeBlock.astro'
import FlowDiagram from '../components/FlowDiagram.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { recordExample } from '../lib/api-reference.js'
import { clientRuns } from '../lib/benchmarks.js'
import { sitePath } from '../lib/paths.js'

type Spec = [string, string]

const engineSpecs: Spec[] = [
  ['Pinned build', 'CEF 156.0.7 on Chromium 156.0.8078.17, beta channel'],
  ['Video', 'CefRenderHandler::OnPaint, BGRA8 or I420 frames with paint IDs'],
  ['Audio', 'CefAudioHandler::OnAudioStreamPacket, 48 kHz stereo PCM'],
  ['Not used', 'No screenshot loop, browser extension or open debugging port'],
  ['Process', 'One sandboxed helper per launch, hosting isolated contexts and many pages'],
  ['Modules', 'protocol, runtime, page and process, with one shutdown barrier'],
  ['Backpressure', 'Callbacks never wait on pipes; one pending frame, 100 audio packets'],
  ['Qualified', '90-case CEF regression package on macOS ARM64, October 21'],
]

const mediaSpecs: Spec[] = [
  ['Capture', '1–120 FPS ceiling per page; actual paints follow page activity'],
  ['Output rate', 'Any rate from 1–120, including 29.97 and 59.94'],
  ['Resampling', 'Newest real image at each tick. Never blended or interpolated'],
  ['macOS path', 'IOSurface capture, Metal NV12 conversion, h264_videotoolbox'],
  ['Audio sync', 'Whole-sample boundaries per tick, so fractional rates never drift'],
  ['Publishing', 'Up to four publishers, adaptive bitrate, supervised reconnects'],
  ['Health', 'Held images, audio gaps, pauses and source switches are counted'],
  ['Narration', 'Kokoro 82M with 28 voices, the macOS voice, Piper via plugins'],
]

const agentSpecs: Spec[] = [
  ['Tools', 'observe, act and wait'],
  ['Observations', 'Compact controls and text, 100 controls and 8 KiB by default'],
  ['Refs', 'Short element refs, replaced on every observation; stale refs rejected'],
  ['Batches', 'Up to 64 known actions in one act, stopping on the first failure'],
  ['Deadlines', 'One shared deadline, 5 s by default and capped at 30 s'],
  ['Safety', 'Mutations are never retried. Password values are redacted'],
  ['Results', 'delivered confirms the browser received it; effect checks the UI'],
]

const mcpSpecs: Spec[] = [
  ['Transport', 'stdio MCP server or one JSON request per line'],
  ['Catalogue', '53 native driver tools plus the three agent tools'],
  ['Groups', 'core by default; add network, state, debug, media or all'],
  ['Backends', 'Launch or attach to Chrome, Firefox or the SuiteCut CEF engine'],
  ['Sessions', 'Named sessions keep a browser alive; idle after ten minutes'],
  ['Artifacts', 'Screenshots as image content, PDFs as embedded resources'],
  ['Remote', 'Connection headers and TLS client certificates for remote browsers'],
]

const viewerSpecs: Spec[] = [
  ['Take control', 'Waits for admitted agent work, then hands input to a person'],
  ['Resume AI', 'Releases held keys and buttons and returns control'],
  ['Same session', 'One page, cookies and storage for both people and agents'],
  ['Private', 'Binds to 127.0.0.1 with a bearer token; no external scripts or CDNs'],
]

const families = [
  'Browser lifecycle',
  'Contexts and profiles',
  'Pages and popups',
  'Navigation',
  'Frames and iframes',
  'Locators',
  'Actionability',
  'Pointer and touch',
  'Keyboard and text',
  'Form controls',
  'Uploads and drag-drop',
  'DOM inspection',
  'Evaluation and handles',
  'Events and cancellation',
  'Dialogs',
  'Downloads',
  'Network observation',
  'Request routing',
  'HAR record and replay',
  'WebSockets',
  'API requests',
  'Storage and auth state',
  'Proxies and permissions',
  'Emulation',
  'Virtual time',
  'Workers',
  'Accessibility',
  'Screenshots',
  'PDF',
  'Video and screencast',
  'Tracing and coverage',
]

const mcpConfig = `{
  "mcpServers": {
    "suitecut": {
      "command": "/usr/local/bin/suitecut-native-control",
      "args": ["--browser", "/usr/bin/chromium", "--mcp", "--tools", "core,network"]
    }
  }
}`

const agentExample = `suitecut::AgentDriver driver(browser);
suitecut::SimpleAgent agent(driver);

auto seen = agent.call("observe", {{"boxes", true}});
auto done = agent.call("act", {
    {"action", "fill"}, {"ref", "e1"}, {"value", "Hello"}});
auto ready = agent.call("wait", {{"text", "Saved"}, {"timeoutMs", 2000}});`

const highlights = clientRuns.filter((row) =>
  ['Launch to ready', 'Small evaluation', 'Locator fill'].includes(row.measure),
)
const format = (value: number) => (value < 10 ? value.toFixed(2) : String(Math.round(value)))
---

<BaseLayout
  title="SuiteCut"
  description="An embedded Chromium engine for recording, streaming, browser agents and MCP, with native capture and a C++ SDK."
  current="home"
>
  <div class="home prose">
    <section class="home-hero">
      <h1>The first embedded Chrome built to be recorded, streamed and driven.</h1>
      <p class="home-lede">
        SuiteCut runs Chromium inside your own process and takes video and sound straight from the
        renderer, with no screenshots, extensions or open debugging port. Drive it from TypeScript,
        C++ or any MCP client, then record it, stream it live, or let an agent work while a person
        watches.
      </p>
      <p class="home-links">
        <a class="tag" href={sitePath('/docs')}>Get started</a>
        <a href="#capabilities">How it works</a>
        <a href="https://github.com/skyaara/suitecut">GitHub</a>
      </p>
    </section>

    <h2 id="capabilities">How it fits together</h2>
    <p>
      One engine sits in the middle. Everything you build talks to it through the same protocol, and
      everything it produces comes from its own paint and audio callbacks.
    </p>
    <FlowDiagram />

    <h2 id="engine">Embedded CEF engine</h2>
    <p>
      SuiteCut ships its own Chromium Embedded Framework runtime. Frames come straight from the
      renderer's paint callback and sound from its audio stream, so what you record is exactly what
      the page drew.
    </p>
    <dl class="specs">
      {
        engineSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>

    <h2 id="media">Media engine</h2>
    <p>
      Capture, resampling, encoding and publishing run natively on one clock. Recording and
      streaming share the pipeline, and the renderer mixes narration with page audio afterwards.
    </p>
    <dl class="specs">
      {
        mediaSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    <CodeBlock code={recordExample} />

    <h2 id="agent">Browser agent</h2>
    <p>
      The simple agent gives a model three tools instead of fifty. It observes the page as compact
      controls, acts on short refs and waits for a visible change, all inside one deadline.
    </p>
    <dl class="specs">
      {
        agentSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    <CodeBlock code={agentExample} label="C++" lang="cpp" />

    <h2 id="mcp">Browser MCP</h2>
    <p>
      <code>suitecut-native-control</code> is a native executable that runs as an MCP server, a line-by-line
      JSON tool or a persistent command-line session. No Node.js, model or task planner is embedded; your
      host brings the agent.
    </p>
    <dl class="specs">
      {
        mcpSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    <CodeBlock code={mcpConfig} label="MCP config" lang="json" />

    <h2 id="control">Browser control</h2>
    <p>
      <code>@suitecut/browser-control</code> drives the CEF engine, installed Chrome, Chromium, Edge or
      Brave over CDP, and Firefox over WebDriver BiDi. It covers 31 feature families, each with scoped
      evidence in the
      <a href="https://github.com/skyaara/suitecut/blob/main/docs/playwright-feature-parity.md"
        >feature checklist</a
      >.
    </p>
    <ul class="families">
      {families.map((family) => <li>{family}</li>)}
    </ul>

    <h3 id="viewer">Live viewer and human handover</h3>
    <dl class="specs">
      {
        viewerSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>

    <h2 id="test">Testing and tracing</h2>
    <p>
      <code>suitecut-test</code> runs suites with fixtures, retries, repeat-each and multi-file discovery,
      and writes JSON, JUnit and HTML reports. <code>expectNative</code> adds retrying and soft assertions,
      <code>toPass</code> and locator handlers.
    </p>
    <p class="muted">
      Tracing is recorded in C++: screencast frames, DOM, network and accessibility snapshots, and
      sources, finalized into a zip. Document coverage and HAR record and replay sit alongside.
    </p>

    <h2 id="benchmarks">Benchmarks</h2>
    <p>
      The native C++ client against the Node SDK, driving the same pinned CEF binary. Shorter is
      faster.
    </p>
    <div class="bars">
      {
        highlights.map((row) => {
          const max = Math.max(row.native, row.node)
          return (
            <div class="bar">
              <span class="label">{row.measure}</span>
              <span class="bar-track">
                <span class="bar-fill is-native" style={`width:${(row.native / max) * 100}%`} />
                <span class="bar-value">
                  {format(row.native)} {row.unit}
                </span>
              </span>
              <span class="bar-track">
                <span class="bar-fill" style={`width:${(row.node / max) * 100}%`} />
                <span class="bar-value">
                  {format(row.node)} {row.unit}
                </span>
              </span>
            </div>
          )
        })
      }
      <p class="bars-key label">
        <span><i class="is-native"></i>Native C++</span><span><i></i>Node SDK</span>
      </p>
    </div>
    <p class="muted">
      <a href={sitePath('/benchmarks')}>See every run, its host and how to reproduce it.</a>
    </p>

    <h2 id="platforms">Platforms</h2>
    <dl class="specs">
      <div><dt>Runtime</dt><dd>Linux x64 and macOS ARM64, each with its own qualification</dd></div>
      <div><dt>Not yet</dt><dd>Windows runtime packaging and Safari or WebKit backends</dd></div>
      <div>
        <dt>Requires</dt><dd>Node.js 22, pnpm, FFmpeg and a separately built CEF executable</dd>
      </div>
      <div><dt>Native SDK</dt><dd>Builds without Node.js or CEF headers</dd></div>
      <div>
        <dt>Playback</dt><dd>
          Stock CEF lacks H.264 and AAC playback; a codec build profile is pinned
        </dd>
      </div>
    </dl>

    <h2 id="start">Get started</h2>
    <p class="muted">
      <code>suitecut install</code> fetches checksum-verified media tools and
      <code>suitecut doctor</code> reports what's missing.
    </p>
    <p class="home-links">
      <a class="tag" href={sitePath('/docs')}>Read the guide</a>
      <a href={sitePath('/benchmarks')}>Benchmarks</a>
      <a href={sitePath('/examples')}>Examples</a>
      <a href="https://github.com/skyaara/suitecut">GitHub</a>
    </p>
  </div>
</BaseLayout>

<style>
  .home {
    padding-top: 8rem;
    font-size: 1.25rem;
    line-height: 2rem;
  }

  .home-hero h1 {
    max-width: 26ch;
    margin: 0 0 3rem;
  }

  .home-lede {
    max-width: 40rem;
    margin: 0;
    color: var(--muted);
  }

  .home-hero .home-links {
    margin: 2.5rem 0 0;
  }

  .home h2 {
    margin-top: 8rem;
  }

  /* Specs */
  .specs {
    margin: 2rem 0;
    border-top: 1px solid var(--line);
  }

  .specs div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  .specs dt {
    color: var(--faint);
    font: 400 0.8125rem / 1.75rem var(--mono);
  }

  .specs dd {
    margin: 0;
    color: var(--ink-strong);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .families {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .families li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.3rem 0;
    color: var(--muted);
    font: 400 0.8125rem / 1.5 var(--mono);
  }

  .families li::before {
    content: '';
    width: 0.75rem;
    height: 1px;
    flex: none;
    background: var(--accent);
  }

  /* Benchmark bars */
  .bars {
    display: grid;
    gap: 1.25rem;
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .bar {
    display: grid;
    gap: 0.35rem;
  }

  .bar-track {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bar-fill {
    height: 0.5rem;
    min-width: 2px;
    background: var(--line-strong);
  }

  .bar-fill.is-native {
    background: var(--chrome-bar);
  }

  .bar-value {
    flex: none;
    color: var(--muted);
    font: 400 0.8125rem / 1 var(--mono);
    font-variant-numeric: tabular-nums;
  }

  .bars-key {
    display: flex;
    gap: 1.25rem;
    margin: 0;
  }

  .bars-key span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .bars-key i {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--line-strong);
  }

  .bars-key i.is-native {
    background: var(--chrome-dark);
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    font: 400 0.8125rem / 1.5 var(--mono);
  }

  .home-links a:not(.tag) {
    color: var(--muted);
    text-decoration: none;
  }

  .home-links a:not(.tag):hover {
    color: var(--accent);
  }

  @media (max-width: 52rem) {
    .home {
      padding-top: 4rem;
      font-size: 1.125rem;
      line-height: 1.75rem;
    }

    .home h2 {
      margin-top: 5rem;
    }

    .specs div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .families {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
