---
import CodeBlock from '../components/CodeBlock.astro'
import ComponentRows from '../components/ComponentRows.astro'
import Explainer from '../components/Explainer.astro'
import { snippets } from '../data/components.js'
import { diagrams } from '../data/diagrams.js'
import { recordingChecks, release } from '../data/release.js'
import BaseLayout from '../layouts/BaseLayout.astro'
import { captureRuns, clientRuns } from '../lib/benchmarks.js'
import { sitePath } from '../lib/paths.js'

type Spec = [string, string]

const engineSpecs: Spec[] = [
  ['Pinned build', 'CEF 156.0.30 on Chromium 156.0.8078.96, stable channel'],
  ['Video', 'CefRenderHandler::OnPaint, BGRA8 or I420 frames with paint IDs'],
  ['Audio', 'CefAudioHandler::OnAudioStreamPacket, 48 kHz stereo PCM'],
  ['Not used', 'No screenshot loop, browser extension or open debugging port'],
  ['Protocol', 'One JSON command per line on stdin, length-prefixed binary packets on stdout'],
  ['Modules', 'protocol, runtime, page and process, with one shutdown barrier'],
  ['Backpressure', 'Callbacks never wait on pipes; one pending frame, audio queued whole'],
  ['Regressions', 'Five C++ workflows run against the real engine by a local supervisor'],
]

const mediaSpecs: Spec[] = [
  ['Capture', 'Any FPS from 1 per page; actual paints follow page activity'],
  ['Output rate', 'Any rate from 1, including 29.97 and 59.94'],
  ['Resampling', 'Newest real image at each tick. Never blended or interpolated'],
  ['macOS path', 'IOSurface capture, Metal NV12 conversion, h264_videotoolbox'],
  ['Files', 'WebM with page audio, or hardware H.264 MP4 on macOS'],
  ['Publishing', 'RTMP, RTMPS or TCP, fixed bitrate, optional reconnect policy'],
  ['Health', 'Held images, audio gaps, pauses and source switches are counted'],
  [`${release.version} checks`, `MP4: ${recordingChecks.mp4}`],
]

const agentSpecs: Spec[] = [
  ['Tools', 'observe, act and wait'],
  ['Observations', 'Compact controls and text, with optional control and byte limits'],
  ['Refs', 'Short element refs, replaced on every observation; stale refs rejected'],
  ['Batches', 'Several actions in one act, stopping at the first failure'],
  ['Deadlines', 'One shared deadline, 5 s by default and capped at 30 s'],
  ['Safety', 'Mutations are never retried. Password values are redacted'],
  ['Results', 'delivered records browser acknowledgement; effect checks the UI'],
]

const mcpSpecs: Spec[] = [
  ['Transport', 'stdio MCP server or one JSON request per line'],
  ['Catalogue', '53 native driver tools plus the three agent tools'],
  ['Groups', 'core by default; add network, state, debug, media or all'],
  ['Backends', 'Launch or attach to Chrome, Firefox or the suitecut CEF engine'],
  ['Sessions', 'Named sessions keep a browser alive; idle after ten minutes'],
  ['Artifacts', 'Screenshots as image content, PDFs as embedded resources'],
  ['Remote', 'Connection headers and TLS client certificates for remote browsers'],
]

const externalSpecs: Spec[] = [
  ['Chromium family', 'Installed Chrome or Chromium over a private CDP pipe'],
  ['Firefox', 'Installed Firefox over WebDriver BiDi'],
  ['Attach', 'Connect to a browser that is already running instead of launching one'],
  ['Nothing extra', 'The CLI and C++ SDK need no CEF runtime or automation library'],
]

const embedSpecs: Spec[] = [
  ['The kit', 'One signed folder: the engine bundle, suitecut-session, licences and kit.json'],
  ['API', 'suitecut/embed.h, a C header in the same SuiteCut::Client library'],
  ['Frames', 'NV12 IOSurfaces converted by the engine with Metal, newest frame only'],
  ['Sharing', 'Each tab is unclaimed, held by the agent or held by the person'],
  ['Prompts', 'Dialogs, file choosers, downloads, permissions and logins go to the app'],
  ['Requires', 'macOS 14 or newer on Apple silicon; not notarized'],
]

const highlights = clientRuns.filter((row) =>
  ['Launch to ready', 'Small evaluation', 'Locator fill', 'Peak client memory'].includes(
    row.measure,
  ),
)
const format = (value: number) => (value < 10 ? value.toFixed(2) : String(Math.round(value)))
---

<BaseLayout
  title="suitecut"
  description="An embedded Chromium engine for recording, streaming, browser agents and MCP, with native capture, a C++ SDK and a macOS embed kit."
  current="home"
>
  <div class="home prose">
    <section class="home-hero">
      <h1>Chromium you can record, stream and drive</h1>
      <p class="home-lede">
        suitecut runs Chromium inside a CEF program and takes
        <span class="dp-marker dp-marker-red dp-marker-inline"
          >video and sound straight from the renderer</span
        >, with no screenshots, extensions or open debugging port. Drive it from C++, C or any MCP
        client, record it, stream it live, or show its tabs in your own Mac app while an agent works
        in them.
      </p>
      <p class="home-actions">
        <a class="tag" href={sitePath('/components')}>See the components</a>
        <a class="dp-link" href={sitePath('/docs')}>Read the guide</a>
      </p>
    </section>

    <h2 id="components">Components</h2>
    <p>
      Four native components share one engine. Each has its own page with a diagram and a quick
      start.
    </p>
    <ComponentRows />

    <h2 id="capabilities">How it fits together</h2>
    <p>
      One engine sits in the middle. Everything you build talks to it through the same protocol, and
      everything it produces comes from its own paint and audio callbacks.
      <a href={sitePath('/docs/how-it-works')}>How it works</a> follows a frame through every part.
    </p>
    <Explainer explained={diagrams.engine} />

    <h2 id="engine">Embedded CEF engine</h2>
    <p>
      suitecut ships its own Chromium Embedded Framework runtime. Frames come straight from the
      renderer's paint callback and sound from its audio stream, so what you record is exactly what
      the page drew.
    </p>
    <dl class="specs">
      {
        engineSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    <CodeBlock code={snippets.engineProtocol} label="JSON" lang="json" />

    <h2 id="media">Recording and streaming</h2>
    <p>
      Capture, resampling, encoding and publishing run natively on one clock. Recording and
      streaming share the pipeline; only the last step differs.
    </p>
    <dl class="specs">
      {
        mediaSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    <CodeBlock code={snippets.recordCode} label="Terminal" lang="bash" />
    <p class="muted">
      <a href={sitePath('/docs/recording')}>The recording and streaming commands</a>.
    </p>

    <h2 id="sdk">C++ SDK and C ABI</h2>
    <p>
      <code>SuiteCut::Client</code> is a C++20 library with browsers, contexts, pages and locators, and
      a versioned C ABI for any language that can call C. It needs no CEF headers.
    </p>
    <CodeBlock code={snippets.cppCode} label="C++" lang="cpp" />

    <h3 id="agent">Browser agent</h3>
    <p>
      The simple agent gives a model three tools instead of fifty. It observes the page as compact
      controls, acts on short refs and waits for a visible change, all inside one deadline.
    </p>
    <dl class="specs">
      {
        agentSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    <CodeBlock code={snippets.agentCode} label="C++" lang="cpp" />

    <h3 id="external">Use the browser you already have</h3>
    <p>
      You don't need the embedded engine to use the agent. Point suitecut at an installed browser
      and the same observe, act and wait tools, refs and deadlines work against it.
    </p>
    <dl class="specs">
      {
        externalSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>

    <h2 id="mcp">Command line and MCP</h2>
    <p>
      <code>suitecut-native-control</code> is a native executable that runs as an MCP server, a line-by-line
      JSON tool or a persistent command-line session. No model or task planner is embedded; your host
      brings the agent.
    </p>
    <dl class="specs">
      {
        mcpSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    <CodeBlock
      code={`${snippets.controlStart}\n${snippets.cliCode}`}
      label="Terminal"
      lang="bash"
    />
    <CodeBlock code={snippets.mcpConfig} label="MCP config" lang="json" />

    <h2 id="embed">Embed it in a Mac app</h2>
    <p>
      The macOS embed kit is one folder an app copies into its bundle. The app opens a session,
      shows the engine's tabs in its own views and can let an agent work in the same tabs.
    </p>
    <dl class="specs">
      {
        embedSpecs.map(([key, value]) => (
          <div>
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
    <Explainer explained={diagrams.embed} />
    <p class="muted">
      <a href={sitePath('/docs/embedding')}>How embedding works</a>.
    </p>

    <h2 id="benchmarks">Benchmarks</h2>
    <p>
      1080p120 recording on an Apple M4 with page audio and five CPU load workers, in distinct
      frames per second out of 120:
    </p>
    <div class="bars">
      {
        captureRuns.map((row) => (
          <div class="bar">
            <span class="label">{row.run}</span>
            <span class="bar-track">
              <span class="bar-fill is-native" style={`width:${(row.fps / 120) * 100}%`} />
              <span class="bar-value">{row.fps.toFixed(2)}</span>
            </span>
          </div>
        ))
      }
    </div>
    <p>Medians for the C++ SDK driving the pinned CEF binary:</p>
    <dl class="specs">
      {
        highlights.map((row) => (
          <div>
            <dt>{row.measure}</dt>
            <dd>
              {format(row.native)} {row.unit}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="muted">
      <a href={sitePath('/benchmarks')}>See every run, its host and how to reproduce it</a>, and
      suitecut against agent-browser and browser-use on real pages.
    </p>

    <h2 id="platforms">Platforms</h2>
    <dl class="specs">
      <div>
        <dt>Release</dt><dd>
          {release.name} for {release.platform}; interfaces can still change before 1.0
        </dd>
      </div>
      <div>
        <dt>macOS</dt><dd>
          The SDK archives and the embed kit need macOS 14; the full runtime needs macOS 15
        </dd>
      </div>
      <div>
        <dt>Linux x64</dt><dd>Builds from source, but was not tested for {release.version}</dd>
      </div>
      <div><dt>Not yet</dt><dd>Windows runtime packaging and Safari or WebKit backends</dd></div>
      <div>
        <dt>From source</dt><dd>
          CMake, a C++20 compiler, FFmpeg for recording and a separately built CEF engine
        </dd>
      </div>
      <div>
        <dt>C++ SDK</dt><dd>Builds without CEF headers; drives Chrome or Firefox on its own</dd>
      </div>
      <div>
        <dt>Playback</dt><dd>
          H.264, AAC and HEVC play on macOS ARM64 through a third-party codec build; Linux and the
          embed kit's default use stock CEF without them
        </dd>
      </div>
    </dl>

    <h2 id="start">Get started</h2>
    <p class="muted">
      Build the C++ SDK with CMake and the engine against the pinned CEF SDK. The {release.name} archives
      for macOS ARM64 are built and verified but not published yet;
      <a href={sitePath('/docs#release')}>the guide lists them</a>.
    </p>
    <p class="home-links">
      <a class="tag" href={sitePath('/docs')}>Read the guide</a>
      <a href={sitePath('/benchmarks')}>Benchmarks</a>
      <a href={sitePath('/examples')}>Examples</a>
      <a href="https://github.com/skyaara/suitecut">GitHub</a>
    </p>
  </div>
</BaseLayout>

<style>
  .home {
    padding-top: var(--space-18);
  }

  .home-lede {
    margin: 0;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-8) 0 0;
  }

  /* Specs */
  .specs {
    margin: 2rem 0;
    border-top: 1px solid var(--line);
  }

  .specs div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  .specs dt {
    color: var(--muted);
    font: 500 16px / 32px var(--sans);
  }

  .specs dd {
    margin: 0;
    color: var(--ink-strong);
    font-size: 1rem;
    line-height: 1.75rem;
  }

  /* Benchmark bars */
  .bars {
    display: grid;
    gap: 1.25rem;
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .bar {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  .bar-track {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bar-fill {
    height: 0.5rem;
    min-width: 2px;
    background: var(--line-strong);
  }

  .bar-fill.is-native {
    background: var(--chrome-bar);
  }

  .bar-value {
    flex: none;
    color: var(--muted);
    font: 500 16px / 1 var(--sans);
    font-variant-numeric: tabular-nums;
  }

  .home-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    font: 500 16px / 24px var(--sans);
  }

  .home-links a:not(.tag) {
    color: var(--muted);
    text-decoration: none;
  }

  .home-links a:not(.tag):hover {
    color: var(--accent);
  }

  @media (max-width: 52rem) {
    .home {
      padding-top: 4rem;
      font-size: 1.125rem;
      line-height: 1.75rem;
    }

    .home h2 {
      margin-top: 5rem;
    }

    .specs div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
