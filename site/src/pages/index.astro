---
import CodeBlock from '../components/CodeBlock.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { recordExample } from '../lib/api-reference.js'
import { sitePath } from '../lib/paths.js'
---

<BaseLayout
  title="SuiteCut"
  description="Record and stream narrated browser flows with native embedded Chromium capture."
  current="home"
>
  <section class="docs-article">
    <h1>Record browser flows with native Chromium capture</h1>
    <p>
      SuiteCut combines embedded CEF video and page audio with narration, captions, highlights and a
      timeline you can render or stream.
    </p>
    <p>
      <a href={sitePath('/docs')}>Get started</a> · <a href={sitePath('/examples')}
        >Native example</a
      > · <a href="https://github.com/skyaara/suitecut">Source</a>
    </p>
    <h2>Record and render</h2>
    <CodeBlock code={recordExample} />
    <p>
      Build the native browser separately and set its executable path. Capture and output rates
      accept integers from 1 through 120; actual captured motion depends on the page and host.
    </p>
  </section>
</BaseLayout>
