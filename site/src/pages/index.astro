---
import CodeBlock from '../components/CodeBlock.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { recordExample } from '../lib/api-reference.js'
import { sitePath } from '../lib/paths.js'
import '@fontsource-variable/inter'
import '../styles/home.css'

const packages = [
  { name: 'suitecut', text: 'Record, narrate, render and stream browser flows.' },
  {
    name: '@suitecut/browser-control',
    text: 'The native CEF engine, Chromium over CDP and Firefox over WebDriver BiDi, with a live viewer.',
  },
  { name: 'SuiteCut::Client', text: 'A C/C++ SDK with a stable C ABI. No Node.js required.' },
  { name: 'suitecut-native-control', text: 'A CLI that also runs as an MCP server for agents.' },
]
---

<BaseLayout
  title="SuiteCut"
  description="Record and stream narrated browser flows with native embedded Chromium capture."
  current="home"
>
  <article class="landing">
    <header class="home-intro">
      <h1>Script a browser flow. Get back a finished, narrated video.</h1>
      <div class="home-columns">
        <p>
          Have you ever recorded a product tour, then spent an afternoon cutting it, adding captions
          and lining up a voiceover?
        </p>
        <p class="muted">
          SuiteCut drives an embedded Chromium, records its real pixels and page audio, and keeps a
          timeline of every narration, highlight and checkpoint.
        </p>
      </div>
      <p class="home-links">
        <a class="home-button" href={sitePath('/docs')}>Get started</a>
        <a href={sitePath('/examples')}>Examples</a>
        <a href="https://github.com/skyaara/suitecut">GitHub</a>
      </p>
    </header>

    <section>
      <h2><span>01</span>Record</h2>
      <p>
        Write the flow the way you'd write a test. Locators, clicks and navigation drive a real
        embedded browser while SuiteCut captures what it paints.
      </p>
      <p class="muted">
        Call narrate, highlight and checkpoint as you go. Each one is stamped onto an action
        timeline beside the source video, so nothing is edited by hand afterwards.
      </p>
      <CodeBlock code={recordExample} theme="github-light" />
    </section>

    <section>
      <h2><span>02</span>Render</h2>
      <p>
        renderSuiteCut reads the manifest and produces the finished video, with narration, captions,
        highlights and page audio mixed in.
      </p>
      <p class="muted">
        Capture and output rates are independent, from 1 to 120 frames per second. Resampling holds
        or drops real frames by timestamp. It never invents motion that wasn't there.
      </p>
    </section>

    <section>
      <h2><span>03</span>Stream</h2>
      <p>
        launchBrowser and createBroadcast publish the same native pixels and page audio to RTMP or
        RTMPS.
      </p>
      <p class="muted">
        You can switch the broadcast source without dropping the publisher connection. Your
        application owns the browser, the stop signal and the stream credentials.
      </p>
    </section>

    <section>
      <h2><span>04</span>Control</h2>
      <p>The browser layer stands on its own. Use it from TypeScript, C++ or an agent.</p>
      <dl class="home-packages">
        {
          packages.map((item) => (
            <div>
              <dt>{item.name}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section>
      <h2><span>05</span>Before you start</h2>
      <p>Bring Node.js 22, FFmpeg and a built CEF executable.</p>
      <p class="muted">
        suitecut install fetches checksum-verified media tools, and suitecut doctor tells you what's
        missing. Builds are qualified on macOS ARM64 and Linux x64.
      </p>
      <p class="home-links">
        <a class="home-button" href={sitePath('/docs')}>Read the guide</a>
      </p>
    </section>
  </article>
</BaseLayout>
