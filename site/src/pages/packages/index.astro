---
import CodeBlock from '../../components/CodeBlock.astro'
import Film from '../../components/Film.astro'
import PackageRows from '../../components/PackageRows.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { packages } from '../../data/packages.js'
import { sitePath } from '../../lib/paths.js'
---

<BaseLayout
  title="Packages · suitecut"
  description="suitecut's four packages: record and stream browser videos, control Chromium and Firefox from Node, share a browser window with an agent, and control browsers from C++."
  current="packages"
>
  <div class="page prose packages">
    <h1>Packages</h1>
    <p class="lede">
      suitecut comes as four packages. Each one stands alone, and they share one engine: Chromium
      running inside your own program, <span class="dp-marker dp-marker-red dp-marker-inline"
        >recorded and driven without a debugging port</span
      >.
    </p>
    <PackageRows />

    {
      packages.map((item) => (
        <section class="package-block" id={item.slug}>
          <h2>
            <a href={sitePath(`/packages/${item.slug}`)}>{item.name}</a>
          </h2>
          <p class="package-kind">
            <span class="dp-badge dp-badge-neutral">{item.kind}</span>
            <span class="dp-badge dp-badge-neutral">{item.status}</span>
          </p>
          <p>{item.line}.</p>
          <Film slug={item.slug} title={`${item.name}, explained`} />
          <p>{item.intro[0]}</p>
          <CodeBlock
            code={item.install}
            label={item.slug === 'native-sdk' ? 'CMake' : 'Terminal'}
            lang={item.slug === 'native-sdk' ? 'plaintext' : 'bash'}
          />
          <p>
            <a class="dp-link" href={sitePath(`/packages/${item.slug}`)}>
              How {item.name} works
            </a>
          </p>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .lede {
    max-width: 32rem;
  }

  .package-block h2 a {
    color: inherit;
    text-decoration: none;
  }

  .package-kind {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: calc(var(--space-3) * -1);
    font-size: 16px;
    line-height: 24px;
  }
</style>
