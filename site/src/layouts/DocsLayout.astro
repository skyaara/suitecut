---
import BaseLayout from './BaseLayout.astro'
import { sitePath } from '../lib/paths.js'

interface Props {
  title: string
  description: string
  section: 'overview' | 'api' | 'kokoro' | 'audio-plugins' | 'streaming'
}

const { title, description, section } = Astro.props

const categories = [
  {
    key: 'streaming',
    label: 'Live streaming',
    href: '/docs/streaming',
    subcategories: [
      { label: 'Publish a page', hash: 'publish-a-page' },
      { label: 'Stream options', hash: 'stream-options' },
      { label: 'Reconnect and stop', hash: 'reconnect-and-stop' },
      { label: 'Live effects', hash: 'live-effects' },
      { label: 'Verify locally', hash: 'verify-locally' },
    ],
  },
  {
    key: 'overview',
    label: 'Getting started',
    href: '/docs',
    subcategories: [
      { label: 'Requirements', hash: 'requirements' },
      { label: 'Install', hash: 'install' },
      { label: 'Record a flow', hash: 'record-a-flow' },
      { label: 'Run and render', hash: 'run-and-render' },
      { label: 'Playwright Test', hash: 'playwright-test' },
      { label: 'Render quality', hash: 'render-quality' },
    ],
  },
  {
    key: 'api',
    label: 'API and CLI',
    href: '/docs/api',
    subcategories: [
      { label: 'Public exports', hash: 'public-exports' },
      { label: 'Recording options', hash: 'recording-options' },
      { label: 'Fixture methods', hash: 'fixture-methods' },
      { label: 'Capture options', hash: 'capture-options' },
      { label: 'Renderer', hash: 'render-api' },
      { label: 'Playwright Test', hash: 'playwright-test-api' },
      { label: 'Reporter options', hash: 'reporter-options' },
      { label: 'Audio plugins', hash: 'audio-plugin-api' },
      { label: 'CLI flags', hash: 'command-line-flags' },
      { label: 'Recorded test', hash: 'recorded-test' },
    ],
  },
  {
    key: 'kokoro',
    label: 'Kokoro speech',
    href: '/docs/kokoro',
    subcategories: [
      { label: 'Choose a voice', hash: 'choose-a-voice' },
      { label: 'Voice samples', hash: 'voice-samples' },
      { label: 'Bundled files', hash: 'bundled-files' },
      { label: 'macOS voice', hash: 'macos-voice' },
      { label: 'Timing', hash: 'timing' },
      { label: 'Other models', hash: 'other-models' },
    ],
  },
  {
    key: 'audio-plugins',
    label: 'Audio plugins',
    href: '/docs/audio-plugins',
    subcategories: [
      { label: 'Install a family', hash: 'install-a-family' },
      { label: 'Set a voice', hash: 'set-a-voice' },
      { label: 'Playwright Test', hash: 'playwright-test' },
      { label: 'Write a plugin', hash: 'write-a-plugin' },
    ],
  },
] as const
const orderedCategories = [...categories].sort(
  (a, b) =>
    ['overview', 'api', 'streaming', 'kokoro', 'audio-plugins'].indexOf(a.key) -
    ['overview', 'api', 'streaming', 'kokoro', 'audio-plugins'].indexOf(b.key),
)
const content = await Astro.slots.render('default')
const headings = [...content.matchAll(/<h2[^>]*id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/gu)].map(
  (match) => ({ id: match[1], label: match[2]?.replace(/<[^>]+>/gu, '') ?? '' }),
)
---

<BaseLayout title={`${title} · SuiteCut`} description={description} current="docs">
  <div class="docs-shell" data-section={section}>
    <button class="docs-nav-toggle" aria-expanded="false" aria-controls="documentation-navigation">
      <span>Documentation</span><span aria-hidden="true">☰</span>
    </button>
    <nav class="docs-nav" id="documentation-navigation" aria-label="Documentation sections">
      <div class="docs-nav-heading">Documentation <span>v1.0</span></div>
      {
        orderedCategories.map((category) => (
          <details class="docs-nav-category" open={section === category.key}>
            <summary>
              <a
                class="docs-nav-category-link"
                href={sitePath(category.href)}
                aria-current={section === category.key ? 'page' : undefined}
              >
                {category.label}
              </a>
            </summary>
            <ul aria-label={`${category.label} sections`}>
              {category.subcategories.map((subcategory) => (
                <li>
                  <a href={`${sitePath(category.href)}#${subcategory.hash}`}>{subcategory.label}</a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </nav>
    <article class="docs-article">
      <div class="docs-page-meta">
        <span>Documentation / {title}</span><a href="https://github.com/skyaara/suitecut"
          >View source ↗</a
        >
      </div>
      <Fragment set:html={content} />
      <div class="docs-page-bottom">
        <a href="https://github.com/skyaara/suitecut/issues">Report an issue ↗</a><span
          >MIT licensed · Built with Playwright</span
        >
      </div>
    </article>
    <aside class="docs-toc" aria-label="On this page">
      <p>On this page</p>
      {headings.map((heading) => <a href={`#${heading.id}`} set:html={heading.label} />)}
      <a class="docs-toc-github" href="https://github.com/skyaara/suitecut"
        >Contribute on GitHub ↗</a
      >
    </aside>
  </div>
</BaseLayout>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.docs-nav-toggle')
  const navigation = document.querySelector<HTMLElement>('.docs-nav')
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') !== 'true'
    toggle.setAttribute('aria-expanded', String(expanded))
    navigation?.classList.toggle('is-open', expanded)
  })
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.docs-toc > a[href^="#"]')]
  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries.find((entry) => entry.isIntersecting)
      if (!visible) return
      for (const link of links) {
        if (link.hash === `#${visible.target.id}`) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      }
    },
    { rootMargin: '-80px 0px -65% 0px' },
  )
  document.querySelectorAll('.docs-article h2[id]').forEach((heading) => observer.observe(heading))
</script>
