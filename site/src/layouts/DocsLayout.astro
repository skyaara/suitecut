---
import BaseLayout from './BaseLayout.astro'
import { sitePath } from '../lib/paths.js'

interface Props {
  title: string
  description: string
  section:
    | 'overview'
    | 'api'
    | 'browser-control'
    | 'agents'
    | 'kokoro'
    | 'audio-plugins'
    | 'streaming'
    | 'performance'
}

const { title, description, section } = Astro.props

const categories = [
  {
    key: 'overview',
    label: 'Getting started',
    href: '/docs',
  },
  {
    key: 'api',
    label: 'API and CLI',
    href: '/docs/api',
  },
  {
    key: 'browser-control',
    label: 'Browser control',
    href: '/docs/browser-control',
  },
  {
    key: 'agents',
    label: 'Agents and MCP',
    href: '/docs/agents',
  },
  {
    key: 'streaming',
    label: 'Live streaming',
    href: '/docs/streaming',
  },
  {
    key: 'performance',
    label: 'Performance',
    href: '/docs/performance',
  },
  {
    key: 'kokoro',
    label: 'Kokoro speech',
    href: '/docs/kokoro',
  },
  {
    key: 'audio-plugins',
    label: 'Audio plugins',
    href: '/docs/audio-plugins',
  },
] as const

const content = await Astro.slots.render('default')
const titleEnd = content.indexOf('</h1>') + '</h1>'.length
const [lead, body] =
  titleEnd > 4 ? [content.slice(0, titleEnd), content.slice(titleEnd)] : ['', content]
const headings = [...content.matchAll(/<h2[^>]*id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/gu)].map(
  (match) => ({ id: match[1] ?? '', label: (match[2] ?? '').replace(/<[^>]+>/gu, '') }),
)
---

<BaseLayout title={`${title} · SuiteCut`} description={description} current="docs">
  <div class="docs-shell" data-section={section}>
    <nav class="docs-pages" aria-label="Documentation pages">
      {
        categories.map((category) => (
          <a
            href={sitePath(category.href)}
            aria-current={section === category.key ? 'page' : undefined}
          >
            {category.label}
          </a>
        ))
      }
    </nav>
    {
      headings.length > 0 && (
        <nav class="docs-toc docs-toc-side" aria-label="On this page">
          <p>On this page</p>
          <div class="toc-rail" data-toc-rail>
            {headings.map((heading) => (
              <a href={`#${heading.id}`} set:html={heading.label} />
            ))}
          </div>
        </nav>
      )
    }
    <article class="docs-article prose">
      <Fragment set:html={lead} />
      {
        headings.length > 0 && (
          <nav class="docs-toc docs-toc-inline" aria-label="On this page">
            {headings.map((heading) => (
              <a href={`#${heading.id}`} set:html={heading.label} />
            ))}
          </nav>
        )
      }
      <Fragment set:html={body} />
      <div class="docs-bottom label">
        <a href="https://github.com/skyaara/suitecut/issues">Report an issue ↗</a>
        <a href="https://github.com/skyaara/suitecut">View source ↗</a>
      </div>
    </article>
  </div>
</BaseLayout>

<script>
  // Track the section being read. Near the end of the page the reading line moves down the
  // viewport, so the index keeps advancing to the last section even when it is already visible.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.docs-toc a')]
  const rail = document.querySelector<HTMLElement>('[data-toc-rail]')
  const headings = [...document.querySelectorAll<HTMLElement>('.docs-article h2[id]')]

  let frame = 0
  const update = () => {
    frame = 0
    if (headings.length === 0) return
    const viewport = window.innerHeight
    const maxScroll = document.documentElement.scrollHeight - viewport
    const tail = Math.min(1, Math.max(0, (window.scrollY - (maxScroll - viewport)) / viewport))
    const line = viewport * (0.3 + 0.65 * tail)
    let active = 0
    headings.forEach((heading, index) => {
      if (heading.getBoundingClientRect().top <= line) active = index
    })
    if (window.scrollY >= maxScroll - 2) active = headings.length - 1

    const id = headings[active]?.id
    for (const link of links) {
      if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location')
      else link.removeAttribute('aria-current')
    }
    const current = rail?.querySelector<HTMLElement>('[aria-current]')
    if (rail && current) {
      rail.style.setProperty('--progress', `${current.offsetTop + current.offsetHeight / 2}px`)
    }
  }
  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(update)
  }
  window.addEventListener('scroll', schedule, { passive: true })
  window.addEventListener('resize', schedule)
  update()
</script>
