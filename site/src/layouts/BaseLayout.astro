---
import SiteHeader, { type Section } from '../components/SiteHeader.astro'
import { sitePath } from '../lib/paths.js'
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  current?: Section
  socialImage?: string
}

const { title, description, current, socialImage = '/favicon.svg' } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const socialImageUrl = new URL(sitePath(socialImage), Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ededed" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <nav class="index-rail" aria-label="Page index" data-index-rail hidden></nav>
    <div class="sheet">
      {current ? <SiteHeader current={current} /> : <SiteHeader />}
      <main id="main-content" data-index-root><slot /></main>
      <footer class="site-footer">
        <p>SuiteCut 2.0 · MIT License</p>
        <nav aria-label="Footer">
          <a href={sitePath('/docs')}>Docs</a>
          <a href={sitePath('/benchmarks')}>Benchmarks</a>
          <a href="https://github.com/skyaara/suitecut">GitHub</a>
          <a href="https://github.com/skyaara/suitecut/issues">Issues</a>
        </nav>
      </footer>
    </div>
  </body>
</html>

<script>
  // Build the left index from the page's own headings.
  const rail = document.querySelector<HTMLElement>('[data-index-rail]')
  const headings = [...document.querySelectorAll<HTMLElement>('[data-index-root] :is(h2, h3)[id]')]
  if (rail && headings.length > 1) {
    const links = headings.map((heading) => {
      const link = document.createElement('a')
      link.href = `#${heading.id}`
      link.dataset.level = heading.tagName === 'H2' ? '2' : '3'
      const label = document.createElement('span')
      label.textContent = heading.dataset.indexLabel ?? heading.textContent?.trim() ?? ''
      link.append(label)
      link.setAttribute('aria-label', label.textContent)
      rail.append(link)
      return link
    })
    rail.hidden = false

    let frame = 0
    const update = () => {
      frame = 0
      const line = window.innerHeight * 0.35
      let active = 0
      headings.forEach((heading, index) => {
        if (heading.getBoundingClientRect().top <= line) active = index
      })
      links.forEach((link, index) => {
        link.setAttribute('aria-current', String(index === active))
      })
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(update)
      },
      { passive: true },
    )
    update()
  }
</script>
