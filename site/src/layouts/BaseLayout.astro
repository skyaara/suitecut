---
import SiteHeader from '../components/SiteHeader.astro'
import { sitePath } from '../lib/paths.js'
import '@fontsource-variable/manrope'
import '../styles/global.css'
import '../styles/docs.css'
import '../styles/syntax.css'

interface Props {
  title: string
  description: string
  current?: 'home' | 'docs' | 'examples'
  socialImage?: string
}

const {
  title,
  description,
  current,
  socialImage = '/demo/suitecut-field-manual-poster.png',
} = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const socialImageUrl = new URL(sitePath(socialImage), Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'workspace-page': current !== 'home' }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {current ? <SiteHeader current={current} /> : <SiteHeader />}
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <p>SuiteCut</p>
      <p>MIT License</p>
    </footer>
  </body>
</html>
