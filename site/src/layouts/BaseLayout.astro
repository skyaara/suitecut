---
import { ClientRouter } from 'astro:transitions'
import DeliPaper from '../components/DeliPaper.astro'
import SiteHeader, { type Section } from '../components/SiteHeader.astro'
import { sitePath } from '../lib/paths.js'
import '../styles/tokens.css'
import '../styles/deli-paper.css'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  current?: Section
  socialImage?: string
}

const { title, description, current, socialImage = '/favicon.svg' } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const socialImageUrl = new URL(sitePath(socialImage), Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e7e6e2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <DeliPaper />
    <div class="sheet">
      {current ? <SiteHeader current={current} /> : <SiteHeader />}
      <main id="main-content" transition:animate="fade"><slot /></main>
      <footer class="site-footer" transition:persist="site-footer">
        <p>
          suitecut 2.1 · MIT licence · on <a
            href="https://design-system.aakashreddy.com"
            target="_blank"
            rel="noopener noreferrer">Deli Paper</a
          >
        </p>
        <nav aria-label="Footer">
          <a href={sitePath('/packages')}>Packages</a>
          <a href={sitePath('/about')}>About</a>
          <a href={sitePath('/docs')}>Docs</a>
          <a href={sitePath('/benchmarks')}>Benchmarks</a>
          <a href="https://github.com/skyaara/suitecut" target="_blank" rel="noopener noreferrer"
            >GitHub</a
          >
          <a
            href="https://github.com/skyaara/suitecut/issues"
            target="_blank"
            rel="noopener noreferrer">Issues</a
          >
        </nav>
      </footer>
    </div>
    <script is:inline>
      // Deli Paper's Marker without React: cover the stroke, then draw it in once it is in view.
      ;(() => {
        if (!('IntersectionObserver' in window)) return
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            entry.target.setAttribute('data-in', '')
            observer.unobserve(entry.target)
          }
        })
        if (still) return
        document.querySelectorAll('.dp-marker:not([data-armed])').forEach((marker) => {
          marker.setAttribute('data-armed', '')
          requestAnimationFrame(() => observer.observe(marker))
        })
      })()
    </script>
    <script is:inline>
      ;(() => {
        const targets = document.querySelectorAll(
          'main .prose > :not(h1), main .specs > div, main .families > li, main .bars > .bar',
        )
        if (!('IntersectionObserver' in window)) return
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('is-in')
              observer.unobserve(entry.target)
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        )
        targets.forEach((element) => {
          const siblings = [...element.parentElement.children]
          const index = element.parentElement.matches('.prose') ? 0 : siblings.indexOf(element)
          element.dataset.reveal = ''
          element.style.setProperty('--delay', `${Math.min(index, 12) * 45}ms`)
          observer.observe(element)
        })
      })()
    </script>
  </body>
</html>
