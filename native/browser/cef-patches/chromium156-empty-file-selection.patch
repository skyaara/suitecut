+  Document& document = page_holder->GetDocument();
+  document.body()->SetInnerHTMLWithoutTrustedTypes("<input type=file>");
+  auto& input = *To<HTMLInputElement>(document.body()->firstChild());
+  Vector<String> paths;
+  paths.push_back("/native/existing-file");
+  input.SetFilesFromPaths(paths);
+  auto* const old_files = input.files();
+  ASSERT_EQ(1u, old_files->length());
+  input.SetBooleanAttribute(html_names::kWebkitdirectoryAttr, true);
+  auto* listener = MakeGarbageCollected<FileSelectionEventListener>();
+  input.addEventListener(event_type_names::kInput, listener);
+  input.addEventListener(event_type_names::kChange, listener);
+  input.addEventListener(event_type_names::kCancel, listener);
+
+  base::RunLoop run_loop;
