+TEST(FileInputTypeTest, EmptyPathsClearNativeSelection) {
+  test::TaskEnvironment task_environment;
+  ScopedNullExecutionContext execution_context;
+  auto* document =
+      Document::CreateForTest(execution_context.GetExecutionContext());
+  for (bool multiple : {false, true}) {
+    for (bool directory : {false, true}) {
+      auto* input = MakeGarbageCollected<HTMLInputElement>(*document);
+      input->setType(input_type_names::kFile);
+      input->SetBooleanAttribute(html_names::kMultipleAttr, multiple);
+      input->SetBooleanAttribute(html_names::kRequiredAttr, true);
+      Vector<String> paths;
+      paths.push_back("/native/path1");
+      paths.push_back("/native/path2");
+      input->SetFilesFromPaths(paths);
+      auto* const old_files = input->files();
+      ASSERT_EQ(multiple ? 2u : 1u, old_files->length());
+      EXPECT_FALSE(input->ValueMissing());
+      // Empty selection must clear before directory enumeration is considered.
+      input->SetBooleanAttribute(html_names::kWebkitdirectoryAttr, directory);
+      auto* listener = MakeGarbageCollected<FileSelectionEventListener>();
+      input->addEventListener(event_type_names::kInput, listener);
+      input->addEventListener(event_type_names::kChange, listener);
+      input->addEventListener(event_type_names::kCancel, listener);
+
+      input->SetFilesFromPaths(Vector<String>());
+      EXPECT_EQ(0u, input->files()->length());
+      EXPECT_NE(old_files, input->files());
+      EXPECT_EQ(multiple ? 2u : 1u, old_files->length());
+      EXPECT_TRUE(input->ValueMissing());
+      ASSERT_EQ(2u, listener->events.size());
+      EXPECT_EQ(event_type_names::kInput, listener->events[0]);
+      EXPECT_EQ(event_type_names::kChange, listener->events[1]);
+      EXPECT_TRUE(listener->all_trusted);
+
+      // Preserve native unchanged-selection behavior rather than forcing events.
+      listener->events.clear();
+      input->SetFilesFromPaths(Vector<String>());
+      ASSERT_EQ(1u, listener->events.size());
+      EXPECT_EQ(event_type_names::kCancel, listener->events[0]);
+      EXPECT_TRUE(listener->all_trusted);
+    }
+  }
+}
