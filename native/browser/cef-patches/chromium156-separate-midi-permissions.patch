+
+void MidiPermissionContext::UpdateTabContext(
+    const PermissionRequestData& request_data,
+    bool allowed) {
+  if (auto* settings =
+          content_settings::PageSpecificContentSettings::GetForFrame(
+              request_data.id.global_render_frame_host_id())) {
+    if (allowed) {
+      settings->OnContentAllowed(ContentSettingsType::MIDI);
+    } else {
+      settings->OnContentBlocked(ContentSettingsType::MIDI);
+    }
   }
-  return CONTENT_SETTING_ALLOW;
+  if (allowed) {
+    // Actual ordinary device transport permission, without granting SysEx.
+    // Keep Chromium's existing process-scoped MIDI security model.
+    content::ChildProcessSecurityPolicy::GetInstance()->GrantSendMidiMessage(
+        request_data.id.global_render_frame_host_id().child_id.GetUnsafeValue());
+  }
 }
 
 }  // namespace permissions
