+// UI-thread-only process bounds. The shared lease is captured by the real
+// InputRouter callback, so session detachment cannot release a pending slot.
+namespace {
+struct MouseWidgetLeaseRegistry {
+  struct Entry {
+    base::WeakPtr<RenderWidgetHostImpl> widget;
+    std::string token;
+    // A detached session must not forget held or uncertain native input.
+    // Type erasure avoids exposing InputHandler's private lease type here.
+    std::shared_ptr<void> orphan;
+    bool pending = false;
+  };
+  std::map<uintptr_t, Entry> widgets;
+  size_t pending = 0;
+};
+MouseWidgetLeaseRegistry& MouseWidgetLeases() {
+  static base::NoDestructor<MouseWidgetLeaseRegistry> registry;
+  return *registry;
+}
+void PruneDestroyedMouseWidgetOrphans() {
+  auto& entries = MouseWidgetLeases().widgets;
+  for (auto it = entries.begin(); it != entries.end();) {
+    if (!it->second.orphan || it->second.widget || it->second.pending) {
+      ++it;
+      continue;
+    }
+    // Remove the registry entry before releasing its strong orphan owner: its
+    // destructor checks the registry and must not re-enter an erasing entry.
+    auto retired = std::move(it->second.orphan);
+    it = entries.erase(it);
+    retired.reset();
+  }
+}
+}  // namespace
+
+struct InputHandler::MouseWidgetLease {
+  explicit MouseWidgetLease(RenderWidgetHostImpl* host)
+      : widget(host->GetWeakPtr()), key(reinterpret_cast<uintptr_t>(host)),
+        token(base::UnguessableToken::Create().ToString()) {
+    MouseWidgetLeases().widgets.emplace(key,
+        MouseWidgetLeaseRegistry::Entry{widget, token, nullptr, false});
+  }
+  ~MouseWidgetLease() {
+    auto& entries = MouseWidgetLeases().widgets;
+    const auto found = entries.find(key);
+    // A later native allocation may reuse the same address. An old callback's
+    // last owner can retire only its own immutable token, never a newer lease.
+    if (found != entries.end() && found->second.token == token &&
+        !found->second.orphan)
+      entries.erase(found);
+  }
+  void RetainDetached(std::shared_ptr<MouseWidgetLease> self) {
+    if (!widget || (!buttons && !uncertain))
+      return;
+    auto& entries = MouseWidgetLeases().widgets;
+    const auto found = entries.find(key);
+    if (found != entries.end() && found->second.token == token)
+      found->second.orphan = std::move(self);
+  }
+  void SetPending(bool value) {
+    pending = value;
+    auto& entries = MouseWidgetLeases().widgets;
+    const auto found = entries.find(key);
+    if (found != entries.end() && found->second.token == token)
+      found->second.pending = value;
+  }
+  base::WeakPtr<RenderWidgetHostImpl> widget;
+  const uintptr_t key;
+  WeakDocumentPtr document;
+  const std::string token;
+  std::string document_token;
+  int sequence = 0, buttons = 0;
+  bool pending = false, uncertain = false;
+};
