+Response InputHandler::AcquireMouseWidget(
+    const std::string& frame_id, const std::string& loader_id,
+    std::string* lease, std::string* document_token) {
+  if (!host_ || !host_->IsActive() || !host_->GetView())
+    return Response::ServerError("Native mouse document is unavailable");
+  const auto& navigation = host_->GetDevToolsNavigationToken();
+  const std::string current_loader = navigation ? navigation->ToString() : "";
+  if (frame_id != host_->GetDevToolsFrameToken().ToString() ||
+      loader_id != current_loader)
+    return Response::ServerError("Native mouse document identity changed");
+  auto* widget = host_->GetRenderWidgetHost();
+  if (!widget || !widget->GetView() || !widget->IsInitializedAndNotDead())
+    return Response::ServerError("Native mouse widget is unavailable");
+  PruneDestroyedMouseWidgetOrphans();
+  auto& registry = MouseWidgetLeases();
+  if (registry.widgets.size() >= 64 || registry.widgets.contains(reinterpret_cast<uintptr_t>(widget)))
+    return Response::ServerError("Native mouse widget is already leased or capacity exceeded");
+  auto owner = std::make_shared<MouseWidgetLease>(widget);
+  owner->document = host_->GetWeakDocumentPtr();
+  owner->document_token = host_->GetDocumentToken().ToString();
+  *lease = owner->token;
+  *document_token = owner->document_token;
+  mouse_widgets_.emplace(owner->token, std::move(owner));
+  return Response::Success();
+}
+
+void InputHandler::DispatchMouseEventToWidget(
+    const std::string& lease, int sequence, const std::string& type,
+    double x, double y, const std::string& button,
+    std::optional<int> modifiers, std::optional<int> click_count,
+    std::unique_ptr<DispatchMouseEventToWidgetCallback> callback) {
+  const auto found = mouse_widgets_.find(lease);
+  if (found == mouse_widgets_.end()) {
+    callback->sendFailure(Response::InvalidParams("Unknown native mouse lease"));
+    return;
+  }
+  const auto owner = found->second;
+  if (owner->pending || owner->uncertain || sequence <= 0 ||
+      owner->sequence == std::numeric_limits<int>::max() ||
+      sequence != owner->sequence + 1 ||
+      MouseWidgetLeases().pending >= 64 || !std::isfinite(x) ||
+      !std::isfinite(y) || std::abs(x) > 1000000 || std::abs(y) > 1000000 ||
+      (type != "mousePressed" && type != "mouseReleased" && type != "mouseMoved") ||
+      (button != "left" && button != "right" && button != "middle" && button != "none") ||
+      (type != "mouseMoved" && button == "none") ||
+      (modifiers && (*modifiers < 0 || *modifiers > 15)) ||
+      (click_count && (*click_count < 0 || *click_count > 1000))) {
+    callback->sendFailure(Response::InvalidParams("Invalid, busy or retired native mouse sequence"));
+    return;
+  }
+  auto receipt = Input::MouseWidgetReceipt::Create()
+      .SetLease(lease).SetSequence(sequence)
+      .SetDocumentToken(owner->document_token)
+      .SetOutcome("dispatchRefused").SetAckObserved(false)
+      .SetAckSource(static_cast<int>(blink::mojom::InputEventResultSource::kBrowser))
+      .SetAckState(static_cast<int>(blink::mojom::InputEventResultState::kUnknown))
+      .Build();
+  if (!owner->widget) {
+    receipt->SetOutcome("widgetDestroyed");
+    callback->sendSuccess(std::move(receipt));
+    return;
+  }
+  if (!host_ || owner->document.AsRenderFrameHostIfValid() != host_ ||
+      !host_->IsActive() || host_->GetRenderWidgetHost() != owner->widget.get()) {
+    receipt->SetOutcome("documentChanged");
+    callback->sendSuccess(std::move(receipt));
+    return;
+  }
+  if (!owner->widget->GetView() || !owner->widget->IsInitializedAndNotDead()) {
+    callback->sendSuccess(std::move(receipt));
+    return;
+  }
+  const int bit = button == "left" ? 1 : button == "right" ? 2 : button == "middle" ? 4 : 0;
+  const int buttons = type == "mousePressed" ? owner->buttons | bit :
+      type == "mouseReleased" ? owner->buttons & ~bit : owner->buttons;
+  if ((type == "mousePressed" && (owner->buttons & bit)) ||
+      (type == "mouseReleased" && !(owner->buttons & bit)) ||
+      (type == "mouseMoved" && bit && !(owner->buttons & bit))) {
+    callback->sendFailure(Response::InvalidParams("Native mouse button state mismatch"));
+    return;
+  }
+  auto result = CreateWebMouseEvent(type, x, y, ScaleFactor(), modifiers,
+      std::nullopt, button, buttons, click_count, std::nullopt, std::nullopt,
+      std::nullopt, std::nullopt, std::nullopt, std::nullopt, std::nullopt,
+      std::nullopt);
+  if (!result.has_value()) {
+    callback->sendFailure(std::move(result).error());
+    return;
+  }
+  auto event = std::move(result).value();
+  event->SetPositionInScreen(ConvertWidgetPointToScreenPoint(
+      CHECK_DEREF(owner->widget->GetView()), event->PositionInWidget()));
+  // No hit-test or current-widget fallback after acquisition. Recheck directly
+  // before forwarding, after all native event preparation is complete.
+  if (owner->document.AsRenderFrameHostIfValid() != host_ ||
+      host_->GetRenderWidgetHost() != owner->widget.get()) {
+    receipt->SetOutcome("documentChanged");
+    callback->sendSuccess(std::move(receipt));
+    return;
+  }
+  owner->sequence = sequence;
+  owner->SetPending(true);
+  ++MouseWidgetLeases().pending;
+  auto completion = base::BindOnce(
+      [](base::WeakPtr<InputHandler> self,
+         std::shared_ptr<MouseWidgetLease> owner, int buttons,
+         std::unique_ptr<Input::MouseWidgetReceipt> receipt,
+         std::unique_ptr<DispatchMouseEventToWidgetCallback> callback,
+         bool observed, blink::mojom::InputEventResultSource source,
+         blink::mojom::InputEventResultState state) {
+        owner->SetPending(false);
+        --MouseWidgetLeases().pending;
+        const bool renderer_ack = observed &&
+            (source == blink::mojom::InputEventResultSource::kCompositorThread ||
+             source == blink::mojom::InputEventResultSource::kMainThread);
+        if (renderer_ack)
+          owner->buttons = buttons;
+        if ((!observed && state == blink::mojom::InputEventResultState::kUnknown) ||
+            (observed && source == blink::mojom::InputEventResultSource::kUnknown))
+          owner->uncertain = true;
+        // A detached session drops its protocol callback. Physical ownership
+        // remains in this exact closure until native callback completion/drop.
+        if (!self) {
+          owner->RetainDetached(owner);
+          return;
+        }
+        receipt->SetAckObserved(observed);
+        receipt->SetAckSource(static_cast<int>(source));
+        receipt->SetAckState(static_cast<int>(state));
+        if (!owner->widget)
+          receipt->SetOutcome("widgetDestroyed");
+        else if (owner->document.AsRenderFrameHostIfValid() != self->host_ ||
+                 !self->host_ || !self->host_->IsActive())
+          receipt->SetOutcome("documentChanged");
+        else if (renderer_ack)
+          receipt->SetOutcome("rendererAck");
+        else if (observed && source == blink::mojom::InputEventResultSource::kBrowser)
+          receipt->SetOutcome("browserAck");
+        else if (state == blink::mojom::InputEventResultState::kUnknown ||
+                 source == blink::mojom::InputEventResultSource::kUnknown)
+          receipt->SetOutcome("dispatchRetired");
+        callback->sendSuccess(std::move(receipt));
+      }, weak_factory_.GetWeakPtr(), owner, buttons, std::move(receipt),
+      std::move(callback));
+  const auto weak_self = weak_factory_.GetWeakPtr();
+  owner->widget->Focus();
+  if (!weak_self || !owner->widget) {
+    std::move(completion).Run(false,
+        blink::mojom::InputEventResultSource::kBrowser,
+        blink::mojom::InputEventResultState::kUnknown);
+    return;
+  }
+  if (owner->document.AsRenderFrameHostIfValid() != weak_self->host_ ||
+      !weak_self->host_ || !owner->widget->GetView() ||
+      !weak_self->host_->IsActive() ||
+      weak_self->host_->GetRenderWidgetHost() != owner->widget.get()) {
+    std::move(completion).Run(false,
+        blink::mojom::InputEventResultSource::kBrowser,
+        blink::mojom::InputEventResultState::kNoConsumerExists);
+    return;
+  }
+  owner->widget->ForwardMouseEventWithReceipt(*event, owner->document,
+                                              std::move(completion));
+}
+
+Response InputHandler::ReleaseMouseWidget(const std::string& lease) {
+  const auto found = mouse_widgets_.find(lease);
+  if (found == mouse_widgets_.end())
+    return Response::InvalidParams("Unknown native mouse lease");
+  const auto& owner = found->second;
+  if (owner->pending || (owner->widget && (owner->buttons || owner->uncertain)))
+    return Response::ServerError("Native mouse lease still owns input; release buttons or close the original widget");
+  mouse_widgets_.erase(found);
+  return Response::Success();
 }
 
