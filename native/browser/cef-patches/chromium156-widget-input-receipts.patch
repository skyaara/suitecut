+void RenderWidgetHostImpl::ForwardMouseEventWithReceipt(
+    const WebMouseEvent& mouse_event, WeakDocumentPtr expected_document,
+    MouseEventReceipt receipt) {
+  auto completion = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      std::move(receipt), false,
+      blink::mojom::InputEventResultSource::kBrowser,
+      blink::mojom::InputEventResultState::kUnknown);
+  CHECK(WebInputEvent::IsMouseEventType(mouse_event.GetType()));
+  const auto weak_self = weak_factory_.GetWeakPtr();
+  // Preserve the normal browser policy/observer filtering and touch-emulator
+  // admission. A browser refusal does not become a successful renderer ACK.
+  for (auto& mouse_event_callback : mouse_event_callbacks_) {
+    if (mouse_event_callback.Run(mouse_event)) {
+      std::move(completion).Run(false,
+          blink::mojom::InputEventResultSource::kBrowser,
+          blink::mojom::InputEventResultState::kNoConsumerExists);
+      return;
+    }
+    if (!weak_self)
+      return;
+  }
+  if (IsIgnoringWebInputEvents(mouse_event)) {
+    std::move(completion).Run(false,
+        blink::mojom::InputEventResultSource::kBrowser,
+        blink::mojom::InputEventResultState::kNoConsumerExists);
+    return;
+  }
+  // Dismiss any active unbounded surface if a mouse click occurs outside of
+  // its window bounds.
+  if (mouse_event.GetType() == WebInputEvent::Type::kMouseDown && GetView()) {
+    if (auto* root_view = GetView()->GetRootView()) {
+      if (root_view->HasActiveUnboundedSurface()) {
+        if (UnboundedSurfaceWindow* unbounded_window =
+                root_view->GetUnboundedSurfaceWindow()) {
+          gfx::PointF screen_point = mouse_event.PositionInScreen();
+          if (!unbounded_window->GetBounds().Contains(
+                  gfx::ToFlooredPoint(screen_point))) {
+            root_view->DismissUnboundedSurface();
+          }
+        }
+      }
+    }
+  }
+
+  if (!weak_self)
+    return;
+  auto* touch_emulator = GetTouchEmulator(/*create_if_necessary=*/false);
+  if (touch_emulator && touch_emulator->HandleMouseEvent(mouse_event, GetView())) {
+    std::move(completion).Run(false,
+        blink::mojom::InputEventResultSource::kBrowser,
+        blink::mojom::InputEventResultState::kNoConsumerExists);
+    return;
+  }
+  if (!weak_self)
+    return;
+  input::MouseEventWithLatencyInfo mouse_with_latency(mouse_event,
+                                                      ui::LatencyInfo());
+  GetRenderInputRouter()->DispatchInputEventWithLatencyInfo(
+      mouse_with_latency.event, &mouse_with_latency.latency,
+      &mouse_with_latency.event.GetModifiableEventLatencyMetadata());
+  if (!weak_self)
+    return;
+  input::ScopedDispatchToRendererCallback dispatch_callback(
+      GetRenderInputRouter()->GetDispatchToRendererCallback());
+  auto* document = expected_document.AsRenderFrameHostIfValid();
+  if (!document || !document->IsActive() ||
+      document->GetRenderWidgetHost() != this) {
+    std::move(completion).Run(false,
+        blink::mojom::InputEventResultSource::kBrowser,
+        blink::mojom::InputEventResultState::kNoConsumerExists);
+    return;
+  }
+  input_router()->SendMouseEvent(mouse_with_latency,
+      base::BindOnce(
+          [](base::WeakPtr<RenderWidgetHostImpl> self,
+             MouseEventReceipt completion,
+             const input::MouseEventWithLatencyInfo& event,
+             blink::mojom::InputEventResultSource source,
+             blink::mojom::InputEventResultState state) {
+            if (self) {
+              self->GetRenderInputRouter()->GetLatencyTracker()->OnInputEventAck(
+                  event.event, &event.latency, state);
+              // Do not call OnMouseEventAck here: its legacy InputInjector
+              // observer FIFO cannot attribute an independent lease's event.
+              if (self->delegate_ &&
+                  state != blink::mojom::InputEventResultState::kConsumed &&
+                  !self->IsHidden())
+                self->delegate_->HandleMouseEvent(event.event);
+            }
+            std::move(completion).Run(true, source, state);
+          }, weak_factory_.GetWeakPtr(), std::move(completion)),
+      dispatch_callback.callback);
+  if (weak_self && weak_self->owner_delegate_)
+    weak_self->owner_delegate_->RenderWidgetDidForwardMouseEvent(mouse_event);
+}
