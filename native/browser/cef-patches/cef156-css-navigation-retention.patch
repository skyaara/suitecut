+  }
+  // Opt-in ownership precedes the synchronous style/layout update, whose
+  // sheet-removal callbacks must also be captured.
+  retain_navigation_rule_usage_ = true;
+  retained_rule_usage_failed_ = false;
+  retired_rule_usage_.clear();
+  retired_style_sheets_.clear();
+  retained_source_units_ = 0;
+  coverage_enabled_.Set(true);
+  SetCoverageEnabled(true);
+  for (Document* document : dom_agent_->Documents()) {
+    document->GetStyleEngine().MarkAllElementsForStyleRecalc(
+        StyleChangeReasonForTracing::Create(style_change_reason::kInspector));
+    document->UpdateStyleAndLayoutTree();
+  }
+  if (retained_rule_usage_failed_) {
+    SetCoverageEnabled(false);
+    return protocol::Response::ServerError(
+        "CSS navigation retention failed during initial style update");
+  }
+  return protocol::Response::Success();
+}
