+void InspectorCSSAgent::RetireRootRuleUsage() {
+  if (!retain_navigation_rule_usage_ || !tracker_ ||
+      retained_rule_usage_failed_) {
+    return;
+  }
+  // Immutable header/text snapshots retain no DOM or style-sheet object.
+  for (const auto& entry : id_to_inspector_style_sheet_) {
+    auto* sheet = entry.value.Get();
+    String text;
+    if (!sheet->GetText(&text)) {
+      retained_rule_usage_failed_ = true;
+      return;
+    }
+    const auto found = retired_style_sheets_.find(entry.key);
+    if (found != retired_style_sheets_.end()) {
+      if (found->value->getText() != text) {
+        // Changed offsets under the same sheet identity need a separate
+        // mutation-generation protocol; never conflate the source versions.
+        retained_rule_usage_failed_ = true;
+        return;
+      }
+      continue;
+    }
+    if (retired_style_sheets_.size() >= kMaxRetiredSheets ||
+        entry.key.length() > kMaxRetiredStyleSheetIdLength ||
+        text.length() > kMaxRetiredSourceUnits - retained_source_units_) {
+      retained_rule_usage_failed_ = true;
+      return;
+    }
+    auto header = sheet->BuildObjectForStyleSheetInfo();
+    const size_t metadata = size_t(header->getFrameId().length()) +
+        header->getSourceURL().length() + header->getTitle().length() +
+        header->getSourceMapURL(String()).length();
+    if (metadata > 32768 ||
+        metadata > kMaxRetiredSourceUnits - retained_source_units_ -
+                       text.length()) {
+      retained_rule_usage_failed_ = true;
+      return;
+    }
+    retained_source_units_ += text.length() + metadata;
+    retired_style_sheets_.Set(entry.key,
+        protocol::CSS::NavigationCoverageStyleSheet::create()
+            .setHeader(std::move(header)).setText(text).build());
+  }
+  std::unique_ptr<protocol::Array<protocol::CSS::RuleUsage>> current;
+  double timestamp;
+  auto response = CollectCurrentRuleUsage(
+      &current, &timestamp, kMaxRetiredRules - retired_rule_usage_.size());
+  if (!response.IsSuccess()) {
+    retained_rule_usage_failed_ = true;
+    return;
+  }
+  for (auto& usage : *current) {
+    retired_rule_usage_.emplace_back(std::move(usage));
+  }
+}
+
+protocol::Response
+InspectorCSSAgent::stopRuleUsageTrackingWithNavigationRetention(
+    std::unique_ptr<protocol::Array<protocol::CSS::RuleUsage>>* result,
+    std::unique_ptr<protocol::Array<
+        protocol::CSS::NavigationCoverageStyleSheet>>* style_sheets) {
+  if (!retain_navigation_rule_usage_ || !tracker_) {
+    return protocol::Response::ServerError(
+        "CSS navigation-retaining coverage is not enabled");
+  }
+  for (Document* document : dom_agent_->Documents())
+    document->UpdateStyleAndLayoutTree();
+  RetireRootRuleUsage();
+  double timestamp;
+  auto response = TakeRetainedRuleUsage(result, &timestamp);
+  if (response.IsSuccess()) {
+    *style_sheets = std::make_unique<protocol::Array<
+        protocol::CSS::NavigationCoverageStyleSheet>>();
+    for (auto& entry : retired_style_sheets_)
+      (*style_sheets)->emplace_back(std::move(entry.value));
+  }
+  SetCoverageEnabled(false);
+  return response;
 }

