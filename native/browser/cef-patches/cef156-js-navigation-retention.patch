+    int* revision, int* max_chunks, int* max_scripts, int* max_ranges,
+    int* max_source_units) {
+  *revision = 1;
+  *max_chunks = static_cast<int>(kNavigationChunks);
+  *max_scripts = static_cast<int>(kNavigationScripts);
+  *max_ranges = static_cast<int>(kNavigationRanges);
+  *max_source_units = static_cast<int>(kNavigationSourceUnits);
