+bool V8InspectorImpl::acquireNavigationCoverage(V8ProfilerAgentImpl* owner) {
+  if (m_navigationCoverageOwner) return false;
+  // Legacy precise collectors would otherwise drain this owner's counters.
+  for (const auto& group : m_sessions) {
+    for (const auto& entry : group.second) {
+      if (entry.second->profilerAgent()->preciseCoverageStarted()) return false;
+    }
+  }
+  m_navigationCoverageOwner = owner;
+  return true;
+}
+
+void V8InspectorImpl::releaseNavigationCoverage(V8ProfilerAgentImpl* owner) {
+  if (m_navigationCoverageOwner == owner) m_navigationCoverageOwner = nullptr;
+}
