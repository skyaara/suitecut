+
+Response V8ProfilerAgentImpl::startPreciseCoverageWithNavigationRetention(
+    std::optional<bool> detailed, int* revision, double* timestamp) {
+  if (!m_enabled) return Response::ServerError("Profiler is not enabled");
+  if (!m_session->inspector()->acquireNavigationCoverage(this)) {
+    return Response::ServerError("Another precise collector owns this isolate");
+  }
+  auto response = startPreciseCoverage(true, detailed, false, timestamp);
+  if (!response.IsSuccess()) {
+    m_session->inspector()->releaseNavigationCoverage(this);
+    return response;
+  }
+  m_navigationRetaining = true;
+  m_navigationError = String16();
+  m_navigationChunks.clear();
+  m_navigationScripts = m_navigationRanges = m_navigationSourceUnits = 0;
+  *revision = 1;
+  return Response::Success();
+}
+
+void V8ProfilerAgentImpl::collectNavigationCoverage(int destroyed_context_id) {
+  if (!m_navigationRetaining || !m_navigationError.isEmpty()) return;
+  if (m_navigationChunks.size() >= kNavigationChunks) {
+    m_navigationError = "Navigation coverage chunk capacity exceeded";
+    return;
+  }
+  v8::HandleScope scope(m_isolate);
+  // Exactly one isolate collection. Other precise owners are excluded at the
+  // actual mode-changing and draining commands; never collect per session.
+  auto coverage = v8::debug::Coverage::CollectPrecise(m_isolate);
+  size_t script_count = m_navigationScripts;
+  size_t range_count = m_navigationRanges;
+  size_t source_units = m_navigationSourceUnits;
+  // Bound the opt-in typed conversion before allocating protocol objects.
+  for (size_t i = 0; i < coverage.ScriptCount(); ++i) {
+    auto native = coverage.GetScriptData(i);
+    auto script = native.GetScript();
+    int context_id = script->ContextId().FromMaybe(0);
+    if (m_session->inspector()->contextGroupId(context_id) !=
+        m_session->contextGroupId()) continue;
+    v8::Local<v8::String> source;
+    if (!script->Source()->JavaScriptCode().ToLocal(&source)) {
+      m_navigationError = "Actual JavaScript coverage source is unavailable";
+      return;
+    }
+    // URL/name metadata has separate per-field bounds in coverageToProtocol.
+    size_t strings = static_cast<size_t>(source->Length()) + 8192;
+    if (++script_count > kNavigationScripts ||
+        strings > kNavigationSourceUnits - source_units) {
+      m_navigationError = "Navigation coverage source capacity exceeded";
+      return;
+    }
+    source_units += strings;
+    for (size_t f = 0; f < native.FunctionCount(); ++f) {
+      auto function = native.GetFunctionData(f);
+      const size_t count = 1 + function.BlockCount();
+      if (count > kNavigationRanges - range_count) {
+        m_navigationError = "Navigation coverage range capacity exceeded";
+        return;
+      }
+      range_count += count;
+      v8::Local<v8::String> name;
+      size_t length = function.Name().ToLocal(&name) ? name->Length() : 0;
+      if (length > 8192 || length > kNavigationSourceUnits - source_units) {
+        m_navigationError = "Navigation coverage function metadata exceeds capacity";
+        return;
+      }
+      source_units += length;
+    }
+  }
+  std::unique_ptr<protocol::Array<protocol::Profiler::ScriptCoverage>> measured;
+  auto response = coverageToProtocol(m_session->inspector(), coverage, &measured,
+                                    m_session->contextGroupId());
+  if (!response.IsSuccess()) {
+    m_navigationError = "Navigation coverage conversion failed";
+    return;
+  }
+  auto scripts = std::make_unique<
+      protocol::Array<protocol::Profiler::NavigationCoverageScript>>();
+  size_t selected = 0;
+  for (size_t i = 0; i < coverage.ScriptCount(); ++i) {
+    auto script = coverage.GetScriptData(i).GetScript();
+    int context_id = script->ContextId().FromMaybe(0);
+    if (m_session->inspector()->contextGroupId(context_id) !=
+        m_session->contextGroupId()) continue;
+    v8::Local<v8::String> source;
+    if (!script->Source()->JavaScriptCode().ToLocal(&source)) {
+      m_navigationError = "Actual JavaScript coverage source became unavailable";
+      return;
+    }
+    scripts->emplace_back(protocol::Profiler::NavigationCoverageScript::create()
+        .setExecutionContextId(context_id)
+        .setSource(toProtocolString(m_isolate, source))
+        .setCoverage(std::move((*measured)[selected++]))
+        .build());
+  }
+  m_navigationScripts = script_count;
+  m_navigationRanges = range_count;
+  m_navigationSourceUnits = source_units;
+  m_navigationChunks.emplace_back(
+      protocol::Profiler::NavigationCoverageChunk::create()
+          .setSequence(static_cast<int>(m_navigationChunks.size() + 1))
+          .setDestroyedContextId(destroyed_context_id)
+          .setTimestamp(v8::base::TimeTicks::Now().since_origin().InSecondsF())
+          .setResult(std::move(scripts))
+          .build());
+}
+
+Response V8ProfilerAgentImpl::stopPreciseCoverageWithNavigationRetention(
+    std::unique_ptr<protocol::Array<protocol::Profiler::NavigationCoverageChunk>>*
+        result) {
+  if (!m_navigationRetaining)
+    return Response::ServerError("Navigation coverage has not been started");
+  collectNavigationCoverage(0);
+  String16 error = m_navigationError;
+  auto chunks = std::make_unique<
+      protocol::Array<protocol::Profiler::NavigationCoverageChunk>>();
+  chunks->swap(m_navigationChunks);
+  auto response = stopPreciseCoverage();
+  if (!response.IsSuccess()) return response;
+  if (!error.isEmpty()) return Response::ServerError(error.utf8());
+  *result = std::move(chunks);
+  return Response::Success();
+}

