+bool ProcessTimeOverrideCoordinator::SetWallTimeForProcess(base::Time time,
+                                                         bool fixed) {
+  auto& self = Instance();
+  base::AutoLock auto_lock(self.lock_);
+  if (!self.clock_override_ || self.requested_ticks_by_client_.empty() ||
+      time.is_null() || time.is_max() || time.is_min()) {
+    return false;
+  }
+  if (fixed) {
+    self.fixed_wall_time_.store(time, std::memory_order_release);
+    return true;
+  }
+  const auto ticks = self.current_ticks_.load(std::memory_order_acquire);
+  const auto unshifted = self.initial_time_ + (ticks - self.initial_ticks_);
+  const auto offset = time - unshifted;
+  if (offset == base::TimeDelta::Max() || offset == base::TimeDelta::Min()) {
+    return false;
+  }
+  self.wall_time_offset_.store(offset, std::memory_order_release);
+  self.fixed_wall_time_.store(base::Time::Max(), std::memory_order_release);
+  return true;
+}
+
+bool ProcessTimeOverrideCoordinator::ClearWallTimeForProcess() {
+  auto& self = Instance();
+  base::AutoLock auto_lock(self.lock_);
+  if (!self.clock_override_ || self.requested_ticks_by_client_.empty()) {
+    return false;
+  }
+  self.wall_time_offset_.store(base::TimeDelta(), std::memory_order_release);
+  self.fixed_wall_time_.store(base::Time::Max(), std::memory_order_release);
+  return true;
+}
