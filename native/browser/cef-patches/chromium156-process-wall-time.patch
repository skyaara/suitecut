+protocol::Response InspectorEmulationAgent::suiteCutClockCapabilitiesV1(
+    int* revision, String* scope) {
+  *revision = 1;
+  *scope = "rendererProcess";
+  return protocol::Response::Success();
+}
+
+protocol::Response InspectorEmulationAgent::suiteCutSetWallTimeV1(
+    double time_ms, bool fixed, String* scope) {
+  if (!std::isfinite(time_ms) || std::abs(time_ms) > 8640000000000000.) {
+    return protocol::Response::InvalidParams(
+        "Wall time must be a finite ECMAScript epoch millisecond number");
+  }
+  if (virtual_time_policy_.Get().IsNull()) {
+    return protocol::Response::ServerError(
+        "This agent must install native virtual time before wall-time control");
+  }
+  if (!scheduler::ProcessTimeOverrideCoordinator::SetWallTimeForProcess(
+          base::Time::FromMillisecondsSinceUnixEpoch(time_ms), fixed)) {
+    return protocol::Response::ServerError(
+        "Native wall-time owner absent, reserved null time, or saturated offset");
+  }
+  *scope = "rendererProcess";
+  return protocol::Response::Success();
+}
+
+protocol::Response InspectorEmulationAgent::suiteCutClearWallTimeV1(
+    String* scope) {
+  if (virtual_time_policy_.Get().IsNull() ||
+      !scheduler::ProcessTimeOverrideCoordinator::ClearWallTimeForProcess()) {
+    return protocol::Response::ServerError(
+        "This agent has no installed native virtual-time wall clock");
+  }
+  *scope = "rendererProcess";
+  return protocol::Response::Success();
+}
