+protocol::Response InspectorNetworkAgent::suiteCutWebSocketConfigureV1(
+    bool enabled, int* revision, int* sockets, int* messages, int* bytes) {
+  *revision = 1; *sockets = 128; *messages = 64; *bytes = 2097152;
+  if (enabled && !enabled_.Get())
+    return protocol::Response::ServerError("Enable Network before native WebSocket routing");
+  suitecut_websocket_enabled_ = enabled;
+  if (!enabled) {
+    // Disposal emits real close probes and can erase the registry reentrantly.
+    auto previous = std::move(suitecut_websockets_);
+    suitecut_websockets_.clear();
+    for (auto& entry : previous) if (entry.value)
+      entry.value->SuiteCutRouteCommand("abort", String(), 0, {}, 1001,
+                                        "Native routing disabled");
+  }
+  return protocol::Response::Success();
+}
+
+protocol::Response InspectorNetworkAgent::suiteCutWebSocketCommandV1(
+    const String& request_id, const String& action, const String& message_id,
+    int opcode, const String& payload_base64, int code, const String& reason) {
+  auto found = suitecut_websockets_.find(request_id);
+  if (found == suitecut_websockets_.end() || !found->value)
+    return protocol::Response::ServerError("Native WebSocket channel is no longer owned");
+  if (payload_base64.length() > 2796204 || reason.length() > 123 ||
+      message_id.length() > 32)
+    return protocol::Response::InvalidParams("Native WebSocket command exceeds limit");
+  Vector<uint8_t> bytes;
+  if (!Base64Decode(payload_base64, bytes) || bytes.size() > 2097152 ||
+      Base64Encode(bytes) != payload_base64)
+    return protocol::Response::InvalidParams("Invalid canonical native WebSocket payload");
+  const auto error = found->value->SuiteCutRouteCommand(
+      action, message_id, opcode, bytes, code, reason);
+  return error.empty() ? protocol::Response::Success()
+                       : protocol::Response::ServerError(error);
+}
+
+void InspectorNetworkAgent::SuiteCutInterceptWebSocket(
+    ExecutionContext*, uint64_t identifier, const KURL& url,
+    SuiteCutWebSocketRoute* channel, bool* intercepted) {
+  if (!suitecut_websocket_enabled_ || *intercepted) return;
+  // Weak expired entries do not consume the live-channel budget indefinitely.
+  Vector<String> expired;
+  for (const auto& entry : suitecut_websockets_) if (!entry.value)
+    expired.push_back(entry.key);
+  for (const auto& id : expired) suitecut_websockets_.erase(id);
+  if (suitecut_websockets_.size() >= 128) {
+    channel->SuiteCutRouteCommand("abort", String(), 0, {}, 1001,
+                                  "Native routing socket capacity exceeded");
+    *intercepted = true;
+    return;
+  }
+  const auto id = IdentifiersFactory::SubresourceRequestId(identifier);
+  suitecut_websockets_.Set(id, channel->SuiteCutWeakRoute());
+  *intercepted = true;
+  GetFrontend()->suiteCutWebSocketRoutedV1(id, "created", url.GetString(),
+                                          String(), false, 0, String());
+}
+
+void InspectorNetworkAgent::SuiteCutWebSocketRetired(uint64_t identifier) {
+  const auto id = IdentifiersFactory::SubresourceRequestId(identifier);
+  if (!suitecut_websockets_.Contains(id)) return;
+  suitecut_websockets_.erase(id);
+  GetFrontend()->suiteCutWebSocketRoutedV1(id, "closed", String(), String(),
+                                          false, 0, String());
+}
+
+void InspectorNetworkAgent::SuiteCutWebSocketMessage(
+    uint64_t identifier, const String& message_id, bool outgoing,
+    int opcode, base::span<const uint8_t> bytes) {
+  const auto id = IdentifiersFactory::SubresourceRequestId(identifier);
+  if (!suitecut_websockets_.Contains(id)) return;
+  GetFrontend()->suiteCutWebSocketRoutedV1(id, "message", String(), message_id,
+                                          outgoing, opcode, Base64Encode(bytes));
+}
