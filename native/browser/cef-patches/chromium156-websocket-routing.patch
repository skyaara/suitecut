+void WebSocketChannelImpl::SuiteCutClose(
+    int code, const String& reason, bool clean) {
+  if (identifier_) probe::DidCloseWebSocket(execution_context_, identifier_);
+  client_->DidStartClosingHandshake();
+  HandleDidClose(clean, static_cast<uint16_t>(code), reason);
+}
