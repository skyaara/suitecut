+String WebSocketChannelImpl::SuiteCutRouteCommand(
+    const String& action, const String& message_id, int opcode,
+    base::span<const uint8_t> payload, int code, const String& reason) {
+  if (!suitecut_routed_ || !identifier_ || execution_context_->IsContextDestroyed())
+    return "Native WebSocket route owner is unavailable";
+  if (action == "abort") {
+    execution_context_->GetTaskRunner(TaskType::kNetworking)->PostTask(
+        FROM_HERE, BindOnce(&WebSocketChannelImpl::SuiteCutAbort,
+                            WrapWeakPersistent(this)));
+    return String();
+  }
+  if (action == "connect" || action == "continue" || action == "mock") {
+    if (!suitecut_pending_connect_)
+      return "Native WebSocket connect decision already consumed";
+    suitecut_pending_connect_ = false;
+    if (action == "mock") {
+      suitecut_mock_open_ = true;
+      has_initiated_opening_handshake_ = true;
+      throttle_passed_ = true;
+      handshake_throttle_.reset();
+      client_->DidConnect(String(), String());
+    } else {
+      if (action == "continue") suitecut_routed_ = false;
+      SuiteCutStartTransport();
+    }
+    return String();
+  }
+  if (GetState() != State::kOpen) return "Native WebSocket is not open";
+  if (action == "close") {
+    const auto encoded_reason = reason.Utf8();
+    if (!((code == 1000) || (code >= 3000 && code <= 4999)) ||
+        encoded_reason.length() > 123)
+      return "Invalid native WebSocket close code or reason";
+    base::AutoReset<bool> bypass(&suitecut_bypass_, true);
+    if (suitecut_mock_open_) SuiteCutClose(code, reason, true);
+    else Close(code, reason);
+    return String();
+  }
+  if (action == "drop" || action == "forward" || action == "replace") {
+    auto found = std::find_if(suitecut_pending_.begin(), suitecut_pending_.end(),
+        [&](const SuiteCutMessage& entry) { return entry.id == message_id; });
+    if (found == suitecut_pending_.end())
+      return "Native WebSocket message decision already consumed";
+    // Preserve message order independently in each native direction.
+    for (auto it = suitecut_pending_.begin(); it != found; ++it)
+      if (it->outgoing == found->outgoing)
+        return "Earlier native WebSocket message decision is pending";
+    const bool outgoing = found->outgoing;
+    const int actual_opcode = action == "replace" ? opcode : found->opcode;
+    if (action != "drop" &&
+        ((actual_opcode != 1 && actual_opcode != 2) ||
+         (actual_opcode == 1 && String::FromUtf8(
+             action == "replace" ? payload : base::span<const uint8_t>(found->bytes)).IsNull())))
+      return "Invalid native WebSocket message replacement";
+    if (action != "drop" && outgoing &&
+        (suitecut_mock_open_ || !SuiteCutCanSend(
+            action == "replace" ? payload.size() : found->bytes.size())))
+      return "Native WebSocket server transport unavailable or backpressured";
+    auto bytes = std::move(found->bytes);
+    suitecut_pending_bytes_ -= bytes.size();
+    suitecut_pending_.erase(found);
+    if (action == "drop") { SuiteCutMaybeClose(); return String(); }
+    const auto actual = action == "replace" ? payload : base::span<const uint8_t>(bytes);
+    if (outgoing) {
+      if (suitecut_mock_open_) return "Mock WebSocket has no server transport";
+      base::AutoReset<bool> bypass(&suitecut_bypass_, true);
+      SendFromMemory(actual_opcode == 1 ? kMessageTypeText : kMessageTypeArrayBuffer,
+                     actual, nullptr);
+    } else {
+      SuiteCutDeliver(actual_opcode, actual);
+    }
+    SuiteCutMaybeClose();
+    return String();
+  }
+  if (action == "client" || action == "server") {
+    if ((opcode != 1 && opcode != 2) ||
+        (opcode == 1 && String::FromUtf8(payload).IsNull()))
+      return "Invalid native WebSocket message";
+    if (action == "client") SuiteCutDeliver(opcode, payload);
+    else {
+      if (suitecut_mock_open_ || !SuiteCutCanSend(payload.size()))
+        return "Native WebSocket server transport unavailable or backpressured";
+      base::AutoReset<bool> bypass(&suitecut_bypass_, true);
+      SendFromMemory(opcode == 1 ? kMessageTypeText : kMessageTypeArrayBuffer,
+                     payload, nullptr);
+    }
+    return String();
+  }
+  return "Unsupported native WebSocket route command";
+}
