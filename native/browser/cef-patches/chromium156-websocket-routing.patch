+
+bool WebSocketChannelImpl::SuiteCutCanQueue(size_t bytes) {
+  if (messages_.size() + suitecut_pending_.size() >= 64 || bytes > 2097152)
+    return false;
+  size_t pending = bytes;
+  for (auto& message : messages_) {
+    if (message.Type() == kMessageTypeClose) return false;
+    const auto size = message.Type() == kMessageTypeBlob
+        ? message.GetBlobDataHandle()->size() : message.PendingPayload().size();
+    if (size > 2097152 - pending) return false;
+    pending += size;
+  }
+  return true;
+}
+
+bool WebSocketChannelImpl::SuiteCutCanSend(size_t bytes) const {
+  if (messages_.size() >= 64 || bytes > 2097152) return false;
+  size_t pending = bytes;
+  for (const auto& message : messages_) {
+    // No original Blob read may be bypassed by a newly injected server frame.
+    if (message.Type() == kMessageTypeBlob || message.Type() == kMessageTypeClose)
+      return false;
+    const auto size = message.PendingPayload().size();
+    if (size > 2097152 - pending) return false;
+    pending += size;
+  }
+  return true;
+}
+
+bool WebSocketChannelImpl::SuiteCutHoldMessage(
+    bool outgoing, int opcode, base::span<const uint8_t> bytes) {
+  if (bytes.size() > 2097152 || suitecut_pending_.size() >= 64 ||
+      bytes.size() > 2097152 - suitecut_pending_bytes_ ||
+      suitecut_message_serial_ == std::numeric_limits<uint64_t>::max()) {
+    FailAsError("Native WebSocket route message capacity exceeded");
+    return false;
+  }
+  auto id = String::Number(++suitecut_message_serial_);
+  SuiteCutMessage message{id, base::TimeTicks::Now() + base::Seconds(30),
+                          outgoing, opcode, {}};
+  message.bytes.append_range(bytes);
+  suitecut_pending_bytes_ += bytes.size();
+  suitecut_pending_.push_back(std::move(message));
+  probe::SuiteCutWebSocketMessage(execution_context_, identifier_, id,
+                                  outgoing, opcode, bytes);
+  SuiteCutEnsureTimer(base::Seconds(30));
+  return true;
+}
+
+void WebSocketChannelImpl::SuiteCutEnsureTimer(base::TimeDelta delay) {
+  if (suitecut_expiry_scheduled_) return;
+  suitecut_expiry_scheduled_ = true;
+  execution_context_->GetTaskRunner(TaskType::kNetworking)->PostDelayedTask(
+      FROM_HERE, BindOnce(&WebSocketChannelImpl::SuiteCutExpire,
+                          WrapWeakPersistent(this)), delay);
+}
+
+void WebSocketChannelImpl::SuiteCutExpire() {
+  suitecut_expiry_scheduled_ = false;
+  if (!suitecut_routed_) return;
+  auto deadline = suitecut_pending_connect_ ? suitecut_connect_deadline_
+                                           : base::TimeTicks::Max();
+  for (const auto& message : suitecut_pending_)
+    deadline = std::min(deadline, message.deadline);
+  if (deadline == base::TimeTicks::Max()) return;
+  const auto now = base::TimeTicks::Now();
+  if (now >= deadline) {
+    FailAsError("Native WebSocket route original decision deadline exceeded");
+    return;
+  }
+  // Exactly one timer per channel, even at high message throughput. Decisions
+  // never renew another retained message's original deadline.
+  SuiteCutEnsureTimer(deadline - now);
+}
+
+void WebSocketChannelImpl::SuiteCutDeliver(
+    int opcode, base::span<const uint8_t> bytes) {
+  if (opcode == 1) {
+    client_->DidReceiveTextMessage(String::FromUtf8(bytes));
+  } else {
+    Vector<base::span<const uint8_t>> chunks;
+    if (!bytes.empty()) chunks.push_back(bytes);
+    client_->DidReceiveBinaryMessage(chunks);
+  }
+}
