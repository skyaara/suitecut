{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Client Release + tests",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/../../.suitecut/build/client-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "release",
      "displayName": "Client ASan + UBSan",
      "binaryDir": "${sourceDir}/../../.suitecut/build/client-sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SUITECUT_CLIENT_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    }
  ]
}
