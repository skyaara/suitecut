{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suitecut:native:protocol:1",
  "title": "SuiteCut complete native protocol v1 envelopes",
  "description": "Validate stdin commands or stdout headers via $defs. Payload type and dimension-dependent byte equality must be checked separately.",
  "$defs": {
    "command": {
      "type": "object",
      "required": ["version", "id", "command"],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "command": {
          "enum": [
            "cdp",
            "devtools",
            "navigate",
            "frames",
            "audio",
            "audio.status",
            "media.start",
            "media.status",
            "media.pause",
            "media.select",
            "media.stop",
            "media.encoders",
            "media.encoder",
            "media.probe",
            "media.cut",
            "media.render",
            "media.cancel"
          ]
        },
        "targetId": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "const": "cdp"
              }
            }
          },
          "then": {
            "required": ["message"],
            "properties": {
              "message": {
                "type": "object",
                "required": ["id", "method"],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "params": {
                    "type": "object"
                  },
                  "sessionId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "devtools"
              }
            }
          },
          "then": {
            "required": ["method", "params"],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "params": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "navigate"
              }
            }
          },
          "then": {
            "required": ["url"],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "enum": ["frames", "audio"]
              }
            }
          },
          "then": {
            "required": ["enabled"],
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "media.start"
              }
            }
          },
          "then": {
            "required": ["destination", "width", "height", "fps"],
            "properties": {
              "destination": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 2,
                "maximum": 3840,
                "multipleOf": 2
              },
              "height": {
                "type": "integer",
                "minimum": 2,
                "maximum": 2160,
                "multipleOf": 2
              },
              "fps": {
                "enum": [30, 60]
              },
              "audio": {
                "type": "boolean",
                "default": true
              },
              "streaming": {
                "type": "boolean",
                "default": false
              },
              "audioStartupTimeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60000
              }
            },
            "not": {
              "required": ["audioStartup"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "enum": ["media.status", "media.pause", "media.select", "media.stop"]
              }
            }
          },
          "then": {
            "required": ["outputId"],
            "properties": {
              "outputId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "media.pause"
              }
            }
          },
          "then": {
            "required": ["paused"],
            "properties": {
              "paused": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "media.select"
              }
            }
          },
          "then": {
            "required": ["targetId"]
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "media.encoder"
              }
            }
          },
          "then": {
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "media.probe"
              }
            }
          },
          "then": {
            "required": ["input"],
            "properties": {
              "input": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "header": {
      "type": "object",
      "required": ["version", "type", "bytes"],
      "properties": {
        "version": {
          "const": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33177600
        }
      },
      "oneOf": [
        {
          "required": ["timestampMs", "cefVersion"],
          "properties": {
            "type": {
              "const": "ready"
            },
            "bytes": {
              "const": 0
            },
            "timestampMs": {
              "$ref": "#/$defs/timestamp"
            },
            "cefVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "nativeMedia": {
              "type": "boolean"
            },
            "frameSubscriptions": {
              "type": "boolean"
            },
            "audioSubscriptions": {
              "type": "boolean"
            }
          }
        },
        {
          "required": ["id", "ok"],
          "properties": {
            "type": {
              "const": "response"
            },
            "bytes": {
              "maximum": 16777216
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "ok": {
              "type": "boolean"
            },
            "error": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        {
          "required": ["topic"],
          "properties": {
            "type": {
              "const": "event"
            },
            "topic": {
              "const": "cdp"
            },
            "bytes": {
              "maximum": 16777216
            }
          }
        },
        {
          "required": ["timestampMs", "width", "height", "dropped"],
          "properties": {
            "type": {
              "const": "frame"
            },
            "timestampMs": {
              "$ref": "#/$defs/timestamp"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2160
            },
            "pixelFormat": {
              "enum": ["bgra", "i420"],
              "default": "bgra"
            },
            "dropped": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "required": ["timestampMs", "frames"],
          "properties": {
            "type": {
              "const": "audio"
            },
            "timestampMs": {
              "$ref": "#/$defs/timestamp"
            },
            "frames": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        },
        {
          "required": ["error"],
          "properties": {
            "type": {
              "const": "error"
            },
            "bytes": {
              "const": 0
            },
            "error": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      ]
    },
    "timestamp": {
      "type": "number",
      "minimum": 0
    }
  }
}
