{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suitecut:cef:protocol:1",
  "title": "SuiteCut native protocol v1 envelopes",
  "description": "Validate stdin commands or stdout headers via $defs. Payload type and dimension-dependent byte equality must be checked separately.",
  "$defs": {
    "command": {
      "type": "object",
      "required": ["version", "id", "command"],
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "command": { "enum": ["cdp", "devtools", "navigate", "frames", "audio", "audio.status"] },
        "targetId": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "command": { "const": "cdp" } } },
          "then": {
            "required": ["message"],
            "properties": {
              "message": {
                "type": "object",
                "required": ["id", "method"],
                "properties": {
                  "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
                  "method": { "type": "string", "minLength": 1 },
                  "params": { "type": "object" },
                  "sessionId": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "command": { "const": "devtools" } } },
          "then": {
            "required": ["method", "params"],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "params": { "type": "object" }
            }
          }
        },
        {
          "if": { "properties": { "command": { "const": "navigate" } } },
          "then": {
            "required": ["url"],
            "properties": { "url": { "type": "string", "pattern": "^https?://" } }
          }
        },
        {
          "if": { "properties": { "command": { "enum": ["frames", "audio"] } } },
          "then": { "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } }
        }
      ]
    },
    "header": {
      "type": "object",
      "required": ["version", "type", "bytes"],
      "properties": {
        "version": { "const": 1 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 33177600 }
      },
      "oneOf": [
        {
          "required": ["timestampMs", "cefVersion"],
          "properties": {
            "type": { "const": "ready" },
            "bytes": { "const": 0 },
            "timestampMs": { "$ref": "#/$defs/timestamp" },
            "cefVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
            "nativeMedia": { "type": "boolean" },
            "frameSubscriptions": { "type": "boolean" },
            "audioSubscriptions": { "type": "boolean" }
          }
        },
        {
          "required": ["id", "ok"],
          "properties": {
            "type": { "const": "response" },
            "bytes": { "maximum": 16777216 },
            "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "ok": { "type": "boolean" },
            "error": { "type": "string", "maxLength": 4096 }
          }
        },
        {
          "required": ["topic"],
          "properties": {
            "type": { "const": "event" },
            "topic": { "const": "cdp" },
            "bytes": { "maximum": 16777216 }
          }
        },
        {
          "required": ["timestampMs", "width", "height", "dropped"],
          "properties": {
            "type": { "const": "frame" },
            "timestampMs": { "$ref": "#/$defs/timestamp" },
            "width": { "type": "integer", "minimum": 1, "maximum": 3840 },
            "height": { "type": "integer", "minimum": 1, "maximum": 2160 },
            "pixelFormat": { "enum": ["bgra", "i420"], "default": "bgra" },
            "dropped": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "required": ["timestampMs", "frames"],
          "properties": {
            "type": { "const": "audio" },
            "timestampMs": { "$ref": "#/$defs/timestamp" },
            "frames": { "type": "integer", "minimum": 1, "maximum": 4096 }
          }
        },
        {
          "required": ["error"],
          "properties": {
            "type": { "const": "error" },
            "bytes": { "const": 0 },
            "error": { "type": "string", "maxLength": 4096 }
          }
        }
      ]
    },
    "timestamp": { "type": "number", "minimum": 0 }
  }
}
