{
  "name": "suitecut-workspace",
  "private": true,
  "description": "Tooling for suitecut's website and benchmark harness. suitecut itself is native: the CEF engine, C++ client SDK and C ABI in native/.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "workspaces": [
    "site"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyaara/suitecut.git"
  },
  "homepage": "https://suitecut.aakashreddy.com",
  "bugs": {
    "url": "https://github.com/skyaara/suitecut/issues"
  },
  "author": "skyaara",
  "scripts": {
    "bench": "node benchmarks/run.mjs",
    "format": "prettier --write \"benchmarks/**/*.mjs\" \"site/**/*.{astro,css,ts,json,mjs}\" \".github/**/*.yml\" \"*.{js,json}\"",
    "format:check": "prettier --check \"benchmarks/**/*.mjs\" \"site/**/*.{astro,css,ts,json,mjs}\" \".github/**/*.yml\" \"*.{js,json}\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "site:build": "pnpm --filter suitecut-docs build",
    "site:check": "pnpm --filter suitecut-docs check",
    "site:sync": "pnpm --filter suitecut-docs sync",
    "test:cef": "python3 tests/cef",
    "test:cef:list": "python3 tests/cef --list",
    "test:cef:unit": "python3 -m unittest discover -s tests/cef/unit -p 'test_*.py'"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
